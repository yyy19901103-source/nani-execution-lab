# Python 内で簡略物理関数を作る（ただし JS の physicsCompressor と同期する必要あり）

def make_X(u_raw):
    parts = [u_raw]
    parts.append(pre_default)
    if ae_default is not None:
        parts.append(ae_default)
    if embed_default is not None:
        parts.append(embed_default)
    return np.concatenate(parts).reshape(1, -1)

def predict_y_target(u_raw):
    X = make_X(u_raw)
    Xs = _scaler.transform(X)
    mus = []; sds = []
    for m in _models:
        mu, sd = m.predict(Xs, return_std=True)
        mus.append(float(mu[0])); sds.append(float(sd[0]))
    return np.array(mus), np.array(sds)

# 物理足し戻し（残差モード時）
def predict_y_real(u_raw, phys_y=None):
    mu_t, sd = predict_y_target(u_raw)
    if _mode == 'residual':
        # phys_y が渡されなければ物理関数で計算
        if phys_y is None:
            ph = physics_python(u_raw.tolist() if hasattr(u_raw, 'tolist') else list(u_raw))
            if ph is not None:
                phys_y = np.array(ph)
        if phys_y is not None:
            mu_real = mu_t + phys_y
        else:
            mu_real = mu_t
    else:
        mu_real = mu_t
    return mu_real, sd

sc_arr = np.array(sc, dtype=float) if len(sc) > 0 else None
def surge_flow_at_press(p):
    if sc_arr is None or len(sc_arr) == 0: return -np.inf
    ps = sc_arr[:, 1]; fs = sc_arr[:, 0]
    order = np.argsort(ps); ps = ps[order]; fs = fs[order]
    if p <= ps[0]: return float(fs[0])
    if p >= ps[-1]: return float(fs[-1])
    return float(np.interp(p, ps, fs))

