---
import BaseLayout from '../../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="コンプレッサ試運転バルブ操作支援 (v5.1)" description="ASME PTC 10 / API 617 準拠 — 操作対象は循環・吸込側バルブのみ。HH:MM:SS時刻・CP932/UTF-8自動判定・列マッピング自由選択・物理事前訓練・残差学習・AE事前学習・LOO-CV・サージ制約逆推定・感度分析・操作シーケンス計画・PTC10適合レポート・モデル保存。データ外部送信ゼロ。">

  <style>
    /* ヘルプ・ツールチップ */
    .help-tip {
      display:inline-block; width:1.1rem; height:1.1rem; line-height:1rem;
      border-radius:50%; background:rgba(200,169,110,0.18); color:#c8a96e;
      text-align:center; font-size:0.7rem; font-weight:600; cursor:help;
      margin-left:0.3rem; vertical-align:middle; position:relative;
      border:1px solid rgba(200,169,110,0.3);
    }
    .help-tip:hover { background:rgba(200,169,110,0.35); }
    .help-tip::after {
      content: attr(data-tip);
      position:absolute; bottom:130%; left:50%; transform:translateX(-50%);
      background:#0c0c0e; color:#edede8; padding:0.7rem 0.9rem;
      border:1px solid rgba(200,169,110,0.4); border-radius:3px;
      font-size:0.72rem; font-weight:400; line-height:1.6; letter-spacing:0.02em;
      white-space:pre-wrap; width:min(380px, 80vw); text-align:left;
      visibility:hidden; opacity:0; transition:opacity 0.15s; pointer-events:none;
      z-index:1000; box-shadow:0 4px 16px rgba(0,0,0,0.4);
    }
    .help-tip:hover::after { visibility:visible; opacity:1; }
    .help-tip.right::after { left:0; transform:none; }
    .spec-guide details { background:#0a0a0c; border:1px solid rgba(255,255,255,0.06); padding:0.8rem 1.1rem; margin-bottom:0.5rem; }
    .spec-guide summary { color:#c8a96e; font-size:0.85rem; cursor:pointer; font-weight:500; }
    .spec-guide summary:hover { color:#edede8; }
    .spec-guide p, .spec-guide li { font-size:0.78rem; color:rgba(237,237,232,0.85); line-height:1.7; }
    .spec-guide code { background:rgba(200,169,110,0.1); color:#c8a96e; padding:0.1rem 0.4rem; font-family:'SF Mono',monospace; font-size:0.72rem; }
  </style>

  <!-- 一発本番モード（最上部・最高優先）-->
  <div style="background:linear-gradient(90deg,rgba(110,200,151,0.18) 0%,rgba(200,169,110,0.12) 50%,rgba(139,109,200,0.15) 100%);border-left:4px solid #6ec897;padding:1rem 1.25rem;font-size:0.82rem;color:#edede8;line-height:1.7;">
    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;">
      <div style="flex:1;min-width:280px;">
        <div style="color:#6ec897;font-size:0.7rem;letter-spacing:0.3em;margin-bottom:0.4rem;">⚡ ONE-SHOT MODE (一発本番モード)</div>
        <div>
          <strong style="color:#6ec897;">失敗の許されない試運転向け：</strong>
          全ツール（物理＋AE＋外部埋め込み＋残差GP＋サージ制約＋感度分析＋シーケンス計画＋公差判定＋Oracle）を最大安全側で同時起動。
          <strong>保守的予測（GP下限）</strong>で安全余裕を確保し、不確実性が高い候補を自動降格します。
        </div>
      </div>
      <label style="display:flex;align-items:center;gap:0.5rem;color:#6ec897;font-size:0.85rem;font-weight:600;cursor:pointer;white-space:nowrap;">
        <input type="checkbox" id="one-shot-mode" />
        ⚡ 一発本番モードを有効化
      </label>
    </div>
    <div id="one-shot-detail" style="display:none;margin-top:0.7rem;padding:0.6rem 0.8rem;background:#0a0a0c;border:1px dashed rgba(110,200,151,0.4);font-size:0.74rem;color:rgba(237,237,232,0.85);line-height:1.6;">
      <strong style="color:#6ec897;">✅ 自動有効化される項目:</strong>
      物理モデル ON / AE事前学習 ON / 外部埋め込みあれば使用 / 残差学習モード / 多重起動を 50 に増強 / 感度分析 ON / シーケンス計画 ON / 公差判定厳格化（既定 5% → 3%）/ 保守的予測モード（GP下限 mu − 1.96σ で目標達成判定）<br>
      <strong style="color:#e8c97a;">⚠ 追加表示:</strong>
      各候補に「Go/No-Go 信号」（GP予測 + 物理整合 + サージ余裕 + 感度低 + LOO-CV信頼性 の5項目総合判定）/ 訓練データ範囲外なら強制 No-Go
    </div>
  </div>

  <!-- 整合性ガード（最優先・赤帯）-->
  <div style="background:rgba(255,107,107,0.10);border-left:4px solid #ff6b6b;padding:1rem 1.25rem;font-size:0.82rem;color:#edede8;line-height:1.7;">
    <div style="color:#ff6b6b;font-size:0.7rem;letter-spacing:0.3em;margin-bottom:0.4rem;">🛡 INTEGRITY GUARD (絶対遵守)</div>
    <div>
      <strong style="color:#ff6b6b;">操作対象：循環ループ + 吸込側バルブのみ。</strong>
      <strong style="color:#ff6b6b;">吐出側は性能測定領域であり、制御変数に含めることを禁止。</strong>
      吐出側を操作することは性能試験の不正に該当します。本ツールは吐出側を「観測専用」として扱い、いかなる操作も推奨しません。
    </div>
  </div>

  <!-- 機密保護 -->
  <div style="background:rgba(200,169,110,0.08);border-left:3px solid #c8a96e;padding:0.85rem 1.25rem;font-size:0.78rem;color:#edede8;display:flex;align-items:center;gap:0.75rem;flex-wrap:wrap;justify-content:space-between;">
    <div>🔒 <strong>機密保護: 全処理ブラウザ完結</strong> — Pyodide WASM 上で scikit-learn 動作。データ・モデル外部送信ゼロ</div>
    <button id="verify-privacy" style="background:transparent;border:1px solid rgba(200,169,110,0.3);color:#c8a96e;padding:0.3rem 0.75rem;font-size:0.7rem;cursor:pointer;font-family:inherit;">検証方法 ▼</button>
  </div>
  <div id="privacy-detail" style="display:none;background:#0a0a0c;border-left:3px solid #c8a96e;padding:1.1rem 1.5rem;font-size:0.76rem;color:rgba(237,237,232,0.75);line-height:1.7;">
    DevTools(F12) → Network「Disable cache」→ リロード。Pyodide/sklearn/numpy/scipyのCDN取得のみ。計算実行中に追加通信ゼロを確認。
  </div>
  <div id="py-status-bar" style="background:#0a0a0c;border-bottom:1px solid rgba(255,255,255,0.05);padding:0.5rem 1.25rem;font-size:0.7rem;color:rgba(255,255,255,0.5);display:flex;justify-content:space-between;align-items:center;">
    <span id="py-status">操作ボタン押下時に Pyodide を起動</span>
    <span id="py-progress" style="color:#6ec897;"></span>
  </div>

  <!-- ヒーロー -->
  <div style="position:relative;height:13rem;overflow:hidden;display:flex;align-items:center;justify-content:center;">
    <div style="position:absolute;inset:0;background:linear-gradient(135deg,#0c0c0e 0%,#0d0d1a 60%,#0c0c0e 100%);"></div>
    <div style="position:absolute;inset:0;opacity:0.04;background-image:repeating-linear-gradient(0deg,transparent,transparent 40px,rgba(200,169,110,0.5) 40px,rgba(200,169,110,0.5) 41px),repeating-linear-gradient(90deg,transparent,transparent 40px,rgba(200,169,110,0.5) 40px,rgba(200,169,110,0.5) 41px);"></div>
    <div style="position:relative;z-index:1;text-align:center;padding:0 1.5rem;">
      <p style="color:#c8a96e;font-size:0.65rem;letter-spacing:0.5em;margin-bottom:1rem;text-transform:uppercase;">Compressor Shop Test · v5.1</p>
      <h1 style="font-size:clamp(1.3rem,3.6vw,1.95rem);font-weight:200;letter-spacing:0.15em;color:#edede8;margin-bottom:0.5rem;">コンプレッサ試運転バルブ操作支援</h1>
      <p style="color:rgba(255,255,255,0.45);font-size:0.78rem;font-weight:300;">物理事前訓練 × 残差GP × AE自己教師あり × HH:MM:SS時刻 × 列マッピング × PTC10レポート</p>
    </div>
  </div>

  <!-- v5.1 機能リスト -->
  <div style="max-width:1300px;margin:0 auto;padding:1rem 1rem 0;">
    <div style="background:linear-gradient(90deg,rgba(110,200,151,0.08) 0%,transparent 100%);border-left:3px solid #6ec897;padding:0.85rem 1.1rem;">
      <div style="color:#6ec897;font-size:0.62rem;letter-spacing:0.3em;margin-bottom:0.4rem;">v5.1 全機能（F1〜F17 + 物理/AE）</div>
      <div style="font-size:0.74rem;color:rgba(237,237,232,0.8);line-height:1.7;">
        <strong style="color:#edede8;">データ:</strong> HH:MM:SS時刻 / CP932自動判定 / 列マッピング / 欠損補間 / 時間範囲整合 / サニティチェック ／
        <strong style="color:#edede8;">モデル:</strong> 物理ON/OFFトグル / 残差学習 / AE事前学習 / N可変バルブ / RPM任意 / 複数吸込 ／
        <strong style="color:#edede8;">分析:</strong> LOO-CV / 感度分析 / バルブ信頼区間 / カバレッジ警告 / 操作シーケンス計画 ／
        <strong style="color:#edede8;">出力:</strong> 性能マップ / PTC10レポート / CSV出力 / モデル保存 (IndexedDB) / 監査ログ
      </div>
    </div>
  </div>

  <div style="max-width:1300px;margin:0 auto;padding:2rem 1rem 5rem;">

    <!-- ===== 3 フェーズタブナビ ===== -->
    <div id="phase-tabs" style="display:flex;gap:0.4rem;margin-bottom:1.5rem;border-bottom:1px solid rgba(200,169,110,0.25);padding-bottom:0.5rem;flex-wrap:wrap;">
      <button data-phase="A" class="phase-tab" style="background:#c8a96e;color:#0c0c0e;border:none;padding:0.6rem 1.1rem;font-size:0.78rem;letter-spacing:0.1em;cursor:pointer;font-weight:600;">Phase A · 事前モデル訓練</button>
      <button data-phase="B" class="phase-tab" style="background:rgba(200,169,110,0.15);color:#c8a96e;border:1px solid rgba(200,169,110,0.4);padding:0.6rem 1.1rem;font-size:0.78rem;letter-spacing:0.1em;cursor:pointer;">Phase B · バルブ開度予測</button>
      <button data-phase="C" class="phase-tab" style="background:rgba(200,169,110,0.15);color:#c8a96e;border:1px solid rgba(200,169,110,0.4);padding:0.6rem 1.1rem;font-size:0.78rem;letter-spacing:0.1em;cursor:pointer;">Phase C · 予実差確認</button>
      <button data-phase="ALL" class="phase-tab" style="background:transparent;color:rgba(255,255,255,0.4);border:1px solid rgba(255,255,255,0.15);padding:0.6rem 1.1rem;font-size:0.78rem;letter-spacing:0.1em;cursor:pointer;">全表示</button>
      <div style="margin-left:auto;display:flex;gap:0.5rem;align-items:center;">
        <a href={`${base}/sample-data/compressor-commissioning/README.md`} target="_blank" style="color:#ffb454;font-size:0.72rem;text-decoration:none;border:1px solid rgba(255,180,84,0.5);padding:0.5rem 0.9rem;letter-spacing:0.05em;" title="物理モデルから合成した架空データ。実機データではありません。">⚠️ サンプルデータ (DUMMY・架空)</a>
      </div>
    </div>
    <div id="phase-desc" style="background:rgba(200,169,110,0.05);border-left:3px solid #c8a96e;padding:0.7rem 1rem;margin-bottom:1.5rem;font-size:0.78rem;color:rgba(237,237,232,0.85);line-height:1.7;">
      <strong style="color:#c8a96e;">Phase A · 事前モデル訓練</strong> — 過去の試運転①データを使って GP+物理モデルを訓練。試運転当日の前に経験者が一度だけ実行。
    </div>

    <!-- ===== STEP 1: データ取込 ===== -->
    <section id="step1" class="phase-A" style="margin-bottom:2rem;">
      <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;">
        <span style="background:#c8a96e;color:#0c0c0e;padding:0.2rem 0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;">STEP 1</span>
        <h2 style="color:#edede8;font-size:1.05rem;font-weight:400;letter-spacing:0.1em;margin:0;">データ取込・列マッピング・整合性チェック</h2>
      </div>

      <div style="background:#111114;border:1px solid rgba(255,255,255,0.06);padding:1.25rem;">
        <!-- バルブ数・RPM 設定 -->
        <div style="background:#0a0a0c;border:1px solid rgba(200,169,110,0.2);padding:0.8rem 1.1rem;margin-bottom:1rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;">
          <span style="color:#c8a96e;font-size:0.7rem;letter-spacing:0.15em;">⚙ 操作対象（吸込・循環側のみ）</span>
          <label style="font-size:0.78rem;color:rgba(237,237,232,0.85);">バルブ数 N:
            <input type="number" id="n-valves" value="3" min="1" max="8" style="width:3.5rem;background:#0c0c0e;border:1px solid rgba(200,169,110,0.4);color:#edede8;padding:0.3rem 0.5rem;margin-left:0.4rem;font-family:inherit;font-size:0.8rem;text-align:center;" />
          </label>
          <label style="font-size:0.78rem;color:rgba(237,237,232,0.85);">
            <input type="checkbox" id="use-rpm" style="margin-right:0.3rem;" /> 速度(RPM)も操作変数に含める
          </label>
          <span style="font-size:0.68rem;color:rgba(255,255,255,0.45);"><strong style="color:#ff6b6b;">吐出側は含まない</strong></span>
        </div>

        <!-- 取込ボタン -->
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:1rem;">
          <button id="btn-load-dummy" style="background:#ffb454;color:#0c0c0e;border:none;padding:0.55rem 1.1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;font-weight:600;letter-spacing:0.05em;">⚡ ダミーデータ一括投入（ワンクリック）</button>
          <span class="help-tip" data-tip="public/sample-data/compressor-commissioning/ の DUMMY サンプル CSV 3 本 (operations.csv / stream.csv / embeddings_timesfm25.csv) を取込み、列マッピングまで自動で確定します。マッピングを編集する必要なし、その場で STEP 2 以降に進めます。すべて物理モデルから合成した架空データです。">?</span>
          <button id="btn-sample" style="background:transparent;border:1px solid rgba(110,200,151,0.4);color:#6ec897;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;">🧪 旧・簡易物理合成（12点デモ）</button>
          <span class="help-tip" data-tip="ツール内蔵の簡易物理モデルで 12 操作 × 3660 秒のミニサンプルを直接合成します（過去バージョン互換）。本格デモは ⚡ ダミーデータ一括投入 を推奨。">?</span>
          <label style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;">
            📂 操作メモCSV
            <input type="file" id="csv-ops" accept=".csv" style="display:none;" />
          </label>
          <span class="help-tip" data-tip="ベテランが操作した時刻と、その時のバルブ開度（と必要なら RPM）が並んだCSV。例: 時刻列 + valve_A_pct + valve_B_pct...。エンコーディングは UTF-8 / CP932 / Shift-JIS を自動判定。時刻は HH:MM:SS（24時間制・前ゼロなしOK）を推奨。10〜20行程度を想定。">?</span>
          <label style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;">
            📂 センサーストリームCSV
            <input type="file" id="csv-stream" accept=".csv" style="display:none;" />
          </label>
          <span class="help-tip" data-tip="1秒間隔のセンサー測定記録。時刻列 + 流量・圧力・温度（吸込側のみ）など複数の y を含む。数千〜数万行を想定。30000+行（数時間〜1日分）が理想。エンコーディングは UTF-8 / CP932 / Shift-JIS 自動判定。時間範囲は操作メモを包含している必要あり。">?</span>
          <label style="background:transparent;border:1px solid rgba(139,109,200,0.4);color:#b89bff;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;">
            🧬 外部埋め込みCSV（TimesFM等・任意・アップロード）
            <input type="file" id="csv-embed" accept=".csv" style="display:none;" />
          </label>
          <span class="help-tip" data-tip="L2 表現学習層との連携用。ローカル（家PC等）で時系列基盤モデル（TimesFM 2.5-200m (2025-10 公開・最新) / 2.0-500m 等）が出力した操作点ごとの埋め込みベクトルを取り込みます。形式: 時刻 + emb_1, emb_2, ..., emb_K の数値列。操作メモの各時刻に近いストリーム位置の埋め込みを使います。提供すれば AE と併用または置換が可能。任意（提供しなくても動作）。">?</span>
        </div>

        <!-- TimesFM 埋め込み使用トグル（明示選択） -->
        <div id="embed-toggle-row" style="display:flex;align-items:center;flex-wrap:wrap;gap:0.7rem;background:rgba(139,109,200,0.06);border:1px solid rgba(139,109,200,0.25);padding:0.6rem 0.9rem;margin-bottom:1rem;">
          <span style="color:#b89bff;font-size:0.72rem;letter-spacing:0.12em;font-weight:600;">🧬 TimesFM 埋め込みを GP 特徴量として使う？</span>
          <label style="display:flex;align-items:center;gap:0.35rem;cursor:pointer;font-size:0.76rem;color:#edede8;">
            <input type="radio" name="use-embed" id="use-embed-yes" value="yes" checked />
            <span>はい（使用する）</span>
          </label>
          <label style="display:flex;align-items:center;gap:0.35rem;cursor:pointer;font-size:0.76rem;color:#edede8;">
            <input type="radio" name="use-embed" id="use-embed-no" value="no" />
            <span>いいえ（不使用 / 物理 + AE のみ）</span>
          </label>
          <span id="embed-status" style="margin-left:auto;font-size:0.72rem;color:rgba(255,255,255,0.5);">取込待ち</span>
          <span class="help-tip" data-tip="ワンクリックでダミーを取り込んだ場合も、アップロードした場合も、ここで GP 訓練時に embedding を特徴量に組み込むかを明示選択できます。「いいえ」にすれば取込済みでも未使用扱い（物理＋AE のみで学習）。比較実験に便利。デフォルトは「はい」。">?</span>
        </div>

        <!-- テンプレート/リセット -->
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:1rem;">
          <button id="btn-template" style="background:transparent;border:1px solid rgba(255,255,255,0.15);color:rgba(237,237,232,0.7);padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;">📥 テンプレートDL</button>
          <span class="help-tip" data-tip="操作メモCSV と センサーストリームCSV の見本ファイルをダウンロードします。実データを用意する際の列構成・時刻形式の参考にできます。">?</span>
          <button id="btn-reset" style="background:transparent;border:1px solid rgba(255,107,107,0.3);color:#ff6b6b;padding:0.5rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;margin-left:auto;">🗑 リセット</button>
        </div>

        <div id="data-status" style="font-size:0.75rem;color:rgba(255,255,255,0.5);margin-bottom:0.75rem;">データ未取込</div>
        <div id="encoding-info" style="display:none;font-size:0.72rem;color:rgba(237,237,232,0.7);margin-bottom:0.5rem;"></div>

        <!-- 列マッピング (F3) -->
        <div id="column-mapping" style="display:none;background:#0a0a0c;border:1px solid rgba(200,169,110,0.2);padding:1rem;margin-bottom:1rem;">
          <div style="color:#c8a96e;font-size:0.7rem;letter-spacing:0.15em;margin-bottom:0.6rem;">📋 列マッピング（取込ファイルの列をツール内部名に対応付け）</div>
          <div id="mapping-ops" style="margin-bottom:0.8rem;"></div>
          <div id="mapping-stream"></div>
          <button id="btn-confirm-mapping" style="margin-top:0.8rem;background:#c8a96e;color:#0c0c0e;border:none;padding:0.5rem 1.2rem;font-size:0.78rem;font-weight:600;cursor:pointer;font-family:inherit;letter-spacing:0.1em;">マッピングを確定 →</button>
          <span class="help-tip" data-tip="選択した列を u/y として確定し、サニティチェック（負値・温度範囲・欠損率・時間範囲整合）を実行します。問題があれば警告表示。物理モデルON時は y のどれが flow/press/temp に対応するかも確定。確定後は STEP 2 物理設定へ進めます。">?</span>
