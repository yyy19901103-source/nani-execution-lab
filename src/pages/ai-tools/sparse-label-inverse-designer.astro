    _phys_py = None

def physics_python(u_raw):
    """JS physicsCompressor の Python 実装。残差モード時に物理予測を返す"""
    if _phys_py is None: return None
    p = _phys_py; N = p['N']
    valves = u_raw[:N]
    rpm = u_raw[N] if (p['useRPM'] and len(u_raw) > N) else (p['rpm_design'] if p['useRPM'] else None)
    q_linear = sum(p['alphas'][i] * valves[i] for i in range(N))
    q_coupling = sum(p['gammas'][i] * valves[i] * valves[i+1] / 100 for i in range(N-1))
    rpm_factor = (rpm / p['rpm_design']) if (p['useRPM'] and rpm is not None) else 1.0
    q = p['q_max'] * (q_linear - q_coupling) / 100 * rpm_factor
    Phi = q / p['Phi_norm']
    Psi = p['a_psi'] - p['b_psi'] * Phi * Phi
    H = max(0.1, Psi * p['H_norm'] * rpm_factor * rpm_factor)
    T_out = p['T_in'] * pow(max(1, H / p['P_atm'] + 1), (p['kappa']-1)/p['kappa'])
    return [q, H, T_out]

pre_default = np.array(_pre_default)
ae_default = np.array(_ae_default) if len(_ae_default) > 0 else None
embed_default = np.array(_embed_default) if len(_embed_default) > 0 else None
