    function computeSequence(results) {
      // 各評価点の (flow, press) を 2D 距離で順序付け
      const pts = results.map((r, i) => ({ idx: i, flow: r.target.flow, press: r.target.press, label: r.label }));
      if (pts.length <= 1) return pts.map(p => p.idx);
      // サージ近くから安全側へ
      // 開始: 流量が中程度の点
      const flows = pts.map(p => p.flow);
      const startVal = (Math.min(...flows) + Math.max(...flows)) / 2;
      let unvisited = [...pts];
      let cur = unvisited.reduce((a, b) => Math.abs(a.flow - startVal) < Math.abs(b.flow - startVal) ? a : b);
      const order = [cur];
      unvisited = unvisited.filter(p => p.idx !== cur.idx);
      while (unvisited.length) {
        const next = unvisited.reduce((a, b) => {
          const da = (a.flow-cur.flow)**2 + ((a.press-cur.press)*10)**2;
          const db = (b.flow-cur.flow)**2 + ((b.press-cur.press)*10)**2;
          return da < db ? a : b;
        });
        order.push(next); cur = next;
        unvisited = unvisited.filter(p => p.idx !== next.idx);
      }
      return order.map(p => p.idx);
    }

