    });

    // ============================================================
    // STEP 3: AE 事前学習
    // ============================================================
    async function runAE() {
      const btn = $('btn-ae'); btn.disabled = true; btn.style.opacity = '0.5';
      const t0 = performance.now();
      clearLog('ae-status'); $('ae-result').style.display = 'none';
      try {
        if (!$('use-ae').checked) { log('ae-status', 'AE は OFF。次STEPへ', '#e8c97a'); setStep(4, true); return; }
        if (!state.mapping) throw new Error('STEP 1 でマッピングを確定してください');
        await ensureSklearn();
        log('ae-status', '✓ sklearn 準備完了', '#6ec897');

        const m = state.mapping;
        const seg = parseInt($('ae-seg').value) || 30;
        const latent = parseInt($('ae-latent').value) || 4;
        const iter = parseInt($('ae-iter').value) || 200;
        // センサーストリームを numpy 形式に (時刻 + y 全列)
        const stream = state.streamRaw.rows.map(r => [
          parseTimestamp(r[m.stTimeIdx]),
          ...m.yIdx.map(yi => parseFloat(r[yi])),
        ]);
        state.pyodide.globals.set('stream_data', stream);
        state.pyodide.globals.set('seg_len', seg);
        state.pyodide.globals.set('latent_dim', latent);
        state.pyodide.globals.set('max_iter', iter);

        const code = `
import numpy as np
from sklearn.neural_network import MLPRegressor
from sklearn.preprocessing import StandardScaler
import json, time

S = np.array(stream_data.to_py(), dtype=float)
# 欠損補間 (F4)
for j in range(1, S.shape[1]):
    col = S[:, j]
    mask = ~np.isnan(col)
    if mask.sum() < 2:
        col[~mask] = 0
    else:
        col[~mask] = np.interp(np.where(~mask)[0], np.where(mask)[0], col[mask])
    S[:, j] = col

# 時刻でソート
order = np.argsort(S[:, 0])
S = S[order]

# セグメント抽出 (連続する seg_len 秒の窓)
sl = int(seg_len)
y_data = S[:, 1:]  # flow, press, temp
ld = int(latent_dim)
mi = int(max_iter)

# 各セグメントを 1サンプルに平坦化（mean+std+slope に簡略化して特徴量爆発を防ぐ）
segments = []
for i in range(0, len(S) - sl, max(1, sl // 4)):  # 75%オーバーラップ
    seg_y = y_data[i:i+sl]
    if len(seg_y) < sl: continue
    feat = np.concatenate([
        seg_y.mean(axis=0),
        seg_y.std(axis=0),
        (seg_y[-1] - seg_y[0])  # 差分（傾きの代替）
    ])
    segments.append(feat)
segments = np.array(segments)

if len(segments) < 10:
    raise ValueError(f'AE用セグメント不足: {len(segments)} 個')

# AE: input → bottleneck(latent) → output (identity mapping)
scaler = StandardScaler().fit(segments)
Xs = scaler.transform(segments)

t0 = time.time()
ae = MLPRegressor(
    hidden_layer_sizes=(16, ld, 16),
    activation='tanh',
    max_iter=mi,
    random_state=42,
    early_stopping=True,
    validation_fraction=0.1,
    n_iter_no_change=20,
)
ae.fit(Xs, Xs)
t_ae = time.time() - t0

# 再構成誤差
recon = ae.predict(Xs)
recon_rmse = float(np.sqrt(np.mean((recon - Xs)**2)))

# 潜在ベクトル取得関数（中間層の活性化を手計算）
def encode_to_latent(X_scaled):
    # 入力 -> 第1層 -> bottleneck (第2層)
    a = X_scaled @ ae.coefs_[0] + ae.intercepts_[0]
    a = np.tanh(a)
    z = a @ ae.coefs_[1] + ae.intercepts_[1]
    z = np.tanh(z)
    return z

# グローバル保存
_ae = ae
_ae_scaler = scaler
_ae_seg_len = sl
_ae_latent_dim = ld
_encode_to_latent = encode_to_latent

result = {
    "n_segments": int(len(segments)),
    "seg_len": int(sl),
    "latent_dim": int(ld),
    "input_dim": int(segments.shape[1]),
    "fit_sec": round(t_ae, 3),
    "recon_rmse_normalized": round(recon_rmse, 4),
    "n_iter": int(ae.n_iter_),
    "converged": bool(ae.n_iter_ < mi),
}
json.dumps(result)
`;
        const resStr = await state.pyodide.runPythonAsync(code);
        const res = JSON.parse(resStr);
        state.aeReady = true;
        audit('ae_trained', res);

        log('ae-status', `✓ セグメント ${res.n_segments} 個 (各 ${res.seg_len}秒, 入力${res.input_dim}次元)`, '#6ec897');
        log('ae-status', `✓ AE訓練完了 ${res.fit_sec}秒 (反復 ${res.n_iter}, 収束=${res.converged ? 'はい' : 'いいえ'})`, '#6ec897');
        log('ae-status', `✓ 再構成誤差(正規化): ${res.recon_rmse_normalized}`, res.recon_rmse_normalized < 0.5 ? '#6ec897' : '#e8c97a');

        $('ae-result').innerHTML =
          `<strong style="color:#6ec897;">潜在次元 ${res.latent_dim} のオートエンコーダ訓練完了。</strong><br>
          dense センサー全体（${res.n_segments} セグメント × ${res.seg_len}秒）で学習した表現を、STEP 4 の GP 訓練で特徴量として追加します。`;
        $('ae-result').style.display = 'block';
        $('ae-elapsed').textContent = `総時間: ${((performance.now()-t0)/1000).toFixed(1)}秒`;
        setStep(4, true);
      } catch (e) {
        log('ae-status', '✗ 失敗: ' + String(e), '#ff6b6b');
        console.error(e);
      } finally {
        btn.disabled = false; btn.style.opacity = '1';
      }
    }
    $('btn-ae').addEventListener('click', runAE);

    // ============================================================
    // STEP 4: GP訓練 (残差 / 直接 + AE特徴量)
    // ============================================================
    async function trainGP() {
      const btn = $('btn-train'); btn.disabled = true; btn.style.opacity = '0.5'; btn.textContent = '⏳ 訓練中...';
      const t0 = performance.now();
      clearLog('train-status'); $('train-result').style.display = 'none';
      try {
        if (!state.mapping) throw new Error('STEP 1 でマッピングを確定してください');
        await ensureSklearn();
        log('train-status', '✓ sklearn 準備完了', '#6ec897');

        const m = state.mapping;
        const settle = parseInt($('opt-settle').value) || 60;
        const wait = parseInt($('opt-settle-wait').value) || 20;
        const pre = parseInt($('opt-pre').value) || 30;
        const restarts = parseInt($('opt-restarts').value) || 8;
        const usePhysics = $('use-physics').checked;
        const useAE = $('use-ae').checked && state.aeReady;

        // 操作メモを numeric に
        const ops = state.opsRaw.rows.map(r => {
          const t = parseTimestamp(r[m.opTimeIdx]);
          const valves = m.valveIdx.map(i => parseFloat(r[i]));
          const rpm = m.useRPM && m.rpmIdx >= 0 ? parseFloat(r[m.rpmIdx]) : null;
          return { t, valves, rpm };
        }).filter(o => !isNaN(o.t) && o.valves.every(v => !isNaN(v)));

        // ストリーム (時刻 + y 全列)
        const stream = state.streamRaw.rows.map(r => [
          parseTimestamp(r[m.stTimeIdx]),
          ...m.yIdx.map(yi => parseFloat(r[yi])),
        ]);

        // 物理予測 (op ごとに事前計算)
        // 物理対応 y がない次元は NaN (Python 側で 0 残差扱い)
        const physicsPreds = usePhysics && state.physicsParams ? ops.map(o => {
          const y = physicsCompressor(o.valves, o.rpm);
          // y_stream の各列に対し、対応する物理値を返す
          return m.yNames.map((_, k) => {
            if (k === m.physFlowYIdx) return y.Q;
            if (k === m.physPressYIdx) return y.P;
            if (k === m.physTempYIdx) return y.T;
            return NaN;  // 物理対応なし → 残差にしない
          });
        }) : null;

        // 外部埋め込みCSV（TimesFM等）— UIトグル「使用する/しない」を尊重
        const useEmbedFromUI = (document.querySelector('input[name="use-embed"]:checked')?.value || 'yes') === 'yes';
        let embedFeatures = null;
        if (state.embedRaw && state.embedRaw.header.length >= 2 && useEmbedFromUI) {
          const embHdr = state.embedRaw.header;
          const embTimeIdx = embHdr.findIndex(h => /時刻|time|timestamp/i.test(h));
          const embTimeCol = embTimeIdx >= 0 ? embTimeIdx : 0;
          const embColIdxs = embHdr.map((_, i) => i).filter(i => i !== embTimeCol);
          const embTimes = state.embedRaw.rows.map(r => parseTimestamp(r[embTimeCol]));
          const embVecs = state.embedRaw.rows.map(r => embColIdxs.map(i => parseFloat(r[i])));
          embedFeatures = ops.map(o => {
            let bestIdx = 0, bestDt = Infinity;
            for (let i = 0; i < embTimes.length; i++) {
              if (isNaN(embTimes[i])) continue;
              const dt = Math.abs(embTimes[i] - o.t);
              if (dt < bestDt) { bestDt = dt; bestIdx = i; }
            }
            return embVecs[bestIdx];
          });
          log('train-status', `✓ 外部埋め込み (TimesFM): ${embedFeatures[0].length}次元 × ${embedFeatures.length}操作点（最近傍マッチ、UI トグル=使用する）`, '#b89bff');
        } else if (state.embedRaw && !useEmbedFromUI) {
          log('train-status', `ℹ️ 外部埋め込みは取込済だが UI トグル「不使用」のためスキップ（物理＋AE のみで学習）`, 'rgba(255,255,255,0.6)');
        }

        state.pyodide.globals.set('ops_data', ops.map(o => ({ t: o.t, valves: o.valves, rpm: o.rpm })));
        state.pyodide.globals.set('stream_data', stream);
        state.pyodide.globals.set('embed_features', embedFeatures);
        state.pyodide.globals.set('settle_sec', settle);
        state.pyodide.globals.set('settle_wait', wait);
        state.pyodide.globals.set('pre_sec', pre);
        state.pyodide.globals.set('n_restarts', restarts);
        state.pyodide.globals.set('valve_names', m.valveNames);
        state.pyodide.globals.set('y_names', m.yNames);
        state.pyodide.globals.set('use_rpm', m.useRPM);
        state.pyodide.globals.set('use_physics', usePhysics);
        state.pyodide.globals.set('use_ae', useAE);
        state.pyodide.globals.set('physics_preds', physicsPreds);

        const code = `
import numpy as np
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import RBF, WhiteKernel, ConstantKernel as C
from sklearn.preprocessing import StandardScaler
import json, time

ops = list(ops_data.to_py())
stream = np.array(stream_data.to_py(), dtype=float)
T_stream = stream[:, 0]
y_stream = stream[:, 1:]  # flow, press, temp

# 欠損補間 (F4)
for j in range(y_stream.shape[1]):
    col = y_stream[:, j].copy()
    mask = ~np.isnan(col)
    if mask.sum() >= 2:
        col[~mask] = np.interp(np.where(~mask)[0], np.where(mask)[0], col[mask])
    y_stream[:, j] = col

vN = list(valve_names.to_py())
yN_user = list(y_names.to_py())
nU_valves = len(vN)
use_rpm_flag = bool(use_rpm)
use_phys = bool(use_physics)
use_ae_flag = bool(use_ae)

# 時刻ソート
order = np.argsort(T_stream)
T_stream = T_stream[order]
y_stream = y_stream[order]

# 各操作で時間窓集約
N = len(ops)
op_times = np.array([o['t'] for o in ops])
order_op = np.argsort(op_times)

X_u = []  # u (バルブ + RPM)
X_pre = []  # 事前窓特徴
X_ae = []  # AE潜在特徴
Y_steady = []  # 整定後 y 平均
Y_std = []  # 整定後 y std
skipped = []
n_y = y_stream.shape[1]  # ユーザー選択した y 数

for oi, idx in enumerate(order_op):
    o = ops[idx]
    t_op = float(o['t'])
    # 整定後窓
    t_start = t_op + int(settle_wait)
    if oi + 1 < N:
        next_t = float(ops[int(order_op[oi+1])]['t'])
        t_end = min(t_op + int(settle_wait) + int(settle_sec), next_t - 1)
    else:
        t_end = t_op + int(settle_wait) + int(settle_sec)
    if t_end - t_start < 5:
        skipped.append({"i": int(idx), "reason": "整定窓不足"}); continue
    mask = (T_stream >= t_start) & (T_stream <= t_end)
    if mask.sum() < 3:
        skipped.append({"i": int(idx), "reason": "整定区間データ不足"}); continue
    y_win = y_stream[mask]
    y_mean = y_win.mean(axis=0)
    y_sd = y_win.std(axis=0) + 1e-9

    # 事前窓
    t_pre_start = max(0, t_op - int(pre_sec))
    mask_pre = (T_stream >= t_pre_start) & (T_stream < t_op)
    if mask_pre.sum() >= 3:
        pre_win = y_stream[mask_pre]
        pre_mean = pre_win.mean(axis=0)
        pre_sd = pre_win.std(axis=0)
        ts = T_stream[mask_pre] - t_op
        slopes = []
        for j in range(n_y):
            if len(ts) >= 2:
                slope = float(np.polyfit(ts, pre_win[:, j], 1)[0])
            else:
                slope = 0.0
            slopes.append(slope)
        pre_feat = np.concatenate([pre_mean, pre_sd, np.array(slopes)])
    else:
        pre_feat = np.zeros(3 * n_y)

    u_vec = list(o['valves'])
    if use_rpm_flag and o.get('rpm') is not None and not np.isnan(o['rpm']):
        u_vec.append(float(o['rpm']))

    # AE潜在ベクトル（事前窓を AEセグメントに変換）
    if use_ae_flag:
        # 事前窓を AE のセグメント長に補正
        sl = _ae_seg_len
        t_ae_start = max(0, t_op - sl)
        mask_ae = (T_stream >= t_ae_start) & (T_stream < t_op)
        if mask_ae.sum() >= 3:
            ae_win = y_stream[mask_ae]
            ae_feat = np.concatenate([
                ae_win.mean(axis=0),
                ae_win.std(axis=0),
                ae_win[-1] - ae_win[0],
            ])
            ae_feat_s = _ae_scaler.transform(ae_feat.reshape(1, -1))
            z = _encode_to_latent(ae_feat_s)[0]
        else:
            z = np.zeros(_ae_latent_dim)
        X_ae.append(z.tolist())

    X_u.append(u_vec)
    X_pre.append(pre_feat.tolist())
    Y_steady.append(y_mean.tolist())
    Y_std.append(y_sd.tolist())

X_u = np.array(X_u, dtype=float)
X_pre = np.array(X_pre, dtype=float)
Y_steady = np.array(Y_steady, dtype=float)
Y_std_arr = np.array(Y_std, dtype=float)

# 外部埋め込み (TimesFM等) を取込（操作と同順序で来ているので、used_indices で揃える）
X_embed_external = None
try:
    if embed_features is not None:
        ef = list(embed_features.to_py())
        # order_op に従い、skipped を除外
        used = [int(i) for i in order_op if i not in [s['i'] for s in skipped]]
        ef_sorted = [ef[i] for i in used if i < len(ef)]
        if len(ef_sorted) == X_u.shape[0]:
            X_embed_external = np.array(ef_sorted, dtype=float)
            # NaN は 0 補間
            X_embed_external = np.where(np.isnan(X_embed_external), 0.0, X_embed_external)
except Exception:
    X_embed_external = None

# 連結
parts = [X_u, X_pre]
if use_ae_flag and len(X_ae):
    X_ae = np.array(X_ae, dtype=float)
    parts.append(X_ae)
if X_embed_external is not None:
    parts.append(X_embed_external)
X_full = np.concatenate(parts, axis=1)
nT = X_full.shape[0]
nFeat = X_full.shape[1]
nY = Y_steady.shape[1]
nU_actual = X_u.shape[1]
y_names = yN_user[:]
while len(y_names) < nY:
    y_names.append(f'y_{len(y_names)+1}')

# 物理予測（残差学習用）
phys_arr = None
if use_phys and physics_preds is not None:
    try:
        pp = list(physics_preds.to_py())
        # ソート順を ops の order_op に合わせる
        pp_sorted = [pp[int(i)] for i in order_op if int(i) < len(pp)]
        # スキップされた行を除外
        used_indices = [int(i) for i in order_op if i not in [s['i'] for s in skipped]]
        phys_arr = np.array([pp[i] for i in used_indices if i < len(pp)], dtype=float)
        if phys_arr.shape[0] != Y_steady.shape[0]:
            # 整合性なければ物理OFF扱い
            phys_arr = None
    except Exception:
        phys_arr = None

# 残差学習: Y_target = Y_steady (直接) または Y_steady - phys (残差)
# phys_arr に NaN が含まれる列（物理対応なし）は 0 残差 = 直接モードになる
if phys_arr is not None and phys_arr.shape == Y_steady.shape:
    phys_arr_safe = np.where(np.isnan(phys_arr), 0.0, phys_arr)
    Y_target = Y_steady - phys_arr_safe
    mode = 'residual'
    phys_arr = phys_arr_safe  # NaN を 0 に
else:
    Y_target = Y_steady
    mode = 'direct'
    phys_arr = None

scaler = StandardScaler().fit(X_full)
Xs = scaler.transform(X_full)

def make_kernel():
    return (
        C(1.0, (1e-3, 1e3))
        * RBF(length_scale=np.ones(nFeat), length_scale_bounds=(1e-1, 1e2))
        + WhiteKernel(noise_level=0.1, noise_level_bounds=(1e-4, 1e1))
    )

# 訓練
models = []; fit_info = []; t_fit_total = 0.0
for j in range(nY):
    yj = Y_target[:, j]
    alpha_j = Y_std_arr[:, j] ** 2
    gpr = GaussianProcessRegressor(
        kernel=make_kernel(), normalize_y=True,
        n_restarts_optimizer=int(n_restarts), random_state=42+j, alpha=alpha_j
    )
    t1 = time.time(); gpr.fit(Xs, yj); t_fit = time.time() - t1
    t_fit_total += t_fit
    yp, ys_p = gpr.predict(Xs, return_std=True)
    models.append(gpr)
    fit_info.append({
        "target": y_names[j], "fit_sec": round(t_fit, 3),
        "kernel": str(gpr.kernel_),
        "log_ml": round(float(gpr.log_marginal_likelihood_value_), 4),
        "rmse_train": round(float(np.sqrt(np.mean((yp - yj)**2))), 4),
    })

# LOO-CV (実 y vs 予測 y で評価、残差なら戻して比較)
loo_results = []
t_loo_start = time.time()
for j in range(nY):
    yj_target = Y_target[:, j]
    yj_real = Y_steady[:, j]
    alpha_j = Y_std_arr[:, j] ** 2
    preds_real = np.zeros(nT); stds = np.zeros(nT)
    for i in range(nT):
        mask = np.ones(nT, dtype=bool); mask[i] = False
        gpr_i = GaussianProcessRegressor(
            kernel=make_kernel(), normalize_y=True,
            n_restarts_optimizer=2, random_state=42+j,
            alpha=alpha_j[mask]
        )
        gpr_i.fit(Xs[mask], yj_target[mask])
        mu_t, sd = gpr_i.predict(Xs[i:i+1], return_std=True)
        # 残差モードなら物理を戻す
        if phys_arr is not None:
            preds_real[i] = mu_t[0] + phys_arr[i, j]
        else:
            preds_real[i] = mu_t[0]
        stds[i] = sd[0]
    rmse = float(np.sqrt(np.mean((preds_real - yj_real)**2)))
    mae = float(np.mean(np.abs(preds_real - yj_real)))
    in95 = float(np.mean(np.abs(preds_real - yj_real) < 1.96 * stds))
    rel_err = float(np.mean(np.abs(preds_real - yj_real) / (np.abs(yj_real) + 1e-9)) * 100)
    loo_results.append({
        "target": y_names[j],
        "loo_rmse": round(rmse, 4), "loo_mae": round(mae, 4),
        "loo_rel_err_pct": round(rel_err, 2),
        "loo_95pct_coverage": round(in95, 3),
    })
t_loo = time.time() - t_loo_start

# 訓練データカバレッジ (F15)
u_min = X_u.min(axis=0).tolist()
u_max = X_u.max(axis=0).tolist()
y_min = Y_steady.min(axis=0).tolist()
y_max = Y_steady.max(axis=0).tolist()

# 監査用情報
audit_info = {
    "mode": mode,
    "use_ae": bool(use_ae_flag),
    "n_train_samples": int(nT),
    "n_features": int(nFeat),
    "n_skipped": len(skipped),
}

# globals保存
_models = models; _scaler = scaler
_X_train = X_u; _X_full = X_full; _Y_train = Y_steady; _Y_std = Y_std_arr
_phys_train = phys_arr
_mode = mode
