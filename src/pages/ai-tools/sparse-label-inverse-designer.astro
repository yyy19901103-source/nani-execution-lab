    // ============================================================
    // ② 物理特性曲線 Ψ-Φ
    // ============================================================
    function drawPsiPhi() {
      if (!state.physicsParams || !state.trained) { alert('物理モデル・GP訓練の両方が必要です'); return; }
      const p = state.physicsParams;
      const cv = $('psiphi-canvas'); const ctx = cv.getContext('2d');
      const W = cv.width, H = cv.height;
      ctx.fillStyle = '#0a0a0c'; ctx.fillRect(0, 0, W, H);
      // 訓練データを (Φ, Ψ) に変換
      state.pyodide.runPythonAsync(`
import json, numpy as np
out = {"X_train": _X_train.tolist(), "Y_train": _Y_train.tolist()}
json.dumps(out)
`).then(s => {
        const d = JSON.parse(s);
        // 各 (u, y) → Φ, Ψ 計算
        // q を u から再計算（実値）、y[0] = flow が実流量
        const trainPts = [];
        for (let i = 0; i < d.X_train.length; i++) {
          const u = d.X_train[i];
          const yFlow = d.Y_train[i][0];  // 流量
          const yPress = d.Y_train[i][1]; // ヘッド (圧力)
          const Phi = yFlow / p.Phi_norm;
          const Psi = yPress / p.H_norm;
          trainPts.push({ Phi, Psi, u });
        }
        // 物理放物線 Ψ = a - b·Φ²
        const PhiMin = 0, PhiMax = 2.2;
        const physCurve = [];
        for (let i = 0; i <= 200; i++) {
          const Phi = PhiMin + (PhiMax - PhiMin) * i / 200;
          const Psi = p.a_psi - p.b_psi * Phi * Phi;
          if (Psi > 0) physCurve.push({ Phi, Psi });
        }
        // サージ点・ストンウォール点
        const surgePhi = p.surge_q_at_full / p.Phi_norm;
        const surgePsi = p.a_psi - p.b_psi * surgePhi * surgePhi;
        const stonewallPhi = PhiMax * 0.9;
        const stonewallPsi = Math.max(0.05, p.a_psi - p.b_psi * stonewallPhi * stonewallPhi);

        // 範囲
        const allPhi = [...physCurve.map(c => c.Phi), ...trainPts.map(t => t.Phi), surgePhi, stonewallPhi];
        const allPsi = [...physCurve.map(c => c.Psi), ...trainPts.map(t => t.Psi), surgePsi, stonewallPsi];
        let xMin = Math.min(...allPhi), xMax = Math.max(...allPhi);
        let yMin = Math.min(...allPsi, 0), yMax = Math.max(...allPsi, p.a_psi);
        xMin -= (xMax-xMin)*0.05; xMax += (xMax-xMin)*0.05;
        yMin -= (yMax-yMin)*0.05; yMax += (yMax-yMin)*0.05;

        const PL=80, PR=30, PT=40, PB=60;
        const pW = W-PL-PR, pH = H-PT-PB;
        const sx = v => PL + (v-xMin)/(xMax-xMin)*pW;
        const sy = v => PT + (1-(v-yMin)/(yMax-yMin))*pH;

        // 軸
        ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1;
        ctx.strokeRect(PL, PT, pW, pH);
        ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.font = '11px monospace'; ctx.fillStyle = 'rgba(255,255,255,0.5)';
        for (let i = 0; i <= 5; i++) {
          const x = PL+pW*i/5; const v1 = xMin+(xMax-xMin)*i/5;
          ctx.beginPath(); ctx.moveTo(x, PT); ctx.lineTo(x, PT+pH); ctx.stroke();
          ctx.fillText(v1.toFixed(2), x-18, PT+pH+16);
          const y = PT+pH*i/5; const v2 = yMax-(yMax-yMin)*i/5;
          ctx.beginPath(); ctx.moveTo(PL, y); ctx.lineTo(PL+pW, y); ctx.stroke();
          ctx.fillText(v2.toFixed(2), 6, y+4);
        }
        ctx.fillStyle = '#c8a96e'; ctx.font = '13px sans-serif';
        ctx.fillText('Φ (流量係数)', W/2-40, H-15);
        ctx.save(); ctx.translate(20, H/2+40); ctx.rotate(-Math.PI/2); ctx.fillText('Ψ (ヘッド係数)', 0, 0); ctx.restore();

        // 物理放物線（金色の線）
        ctx.strokeStyle = '#c8a96e'; ctx.lineWidth = 2.5;
        ctx.beginPath();
        physCurve.forEach((pt, i) => { if (i===0) ctx.moveTo(sx(pt.Phi), sy(pt.Psi)); else ctx.lineTo(sx(pt.Phi), sy(pt.Psi)); });
        ctx.stroke();

        // サージ点
        ctx.fillStyle = '#ff6b6b'; ctx.strokeStyle = '#ff6b6b'; ctx.lineWidth = 2;
        const spx = sx(surgePhi), spy = sy(surgePsi);
        ctx.beginPath(); ctx.moveTo(spx-7, spy); ctx.lineTo(spx, spy-7); ctx.lineTo(spx+7, spy); ctx.lineTo(spx, spy+7); ctx.closePath(); ctx.stroke();
        ctx.fillText('サージ', spx+10, spy-4);
        // ストンウォール点
        const wpx = sx(stonewallPhi), wpy = sy(stonewallPsi);
        ctx.beginPath();
        for (let k = 0; k < 6; k++) {
          const a = k * Math.PI / 3;
          ctx.lineTo(wpx + Math.cos(a)*7, wpy + Math.sin(a)*7);
        }
        ctx.closePath(); ctx.stroke();
        ctx.fillStyle = '#ff6b6b'; ctx.fillText('ストンウォール', wpx+10, wpy-4);

        // 訓練データ点（金色の星）
        ctx.fillStyle = 'rgba(110,200,151,0.85)';
        trainPts.forEach(pt => {
          const px = sx(pt.Phi), py = sy(pt.Psi);
          ctx.beginPath();
          for (let k = 0; k < 5; k++) {
            const a1 = (k*2*Math.PI/5)-Math.PI/2; const a2 = ((k+0.5)*2*Math.PI/5)-Math.PI/2;
            ctx.lineTo(px + Math.cos(a1)*6, py + Math.sin(a1)*6);
            ctx.lineTo(px + Math.cos(a2)*2.5, py + Math.sin(a2)*2.5);
          }
          ctx.closePath(); ctx.fill();
        });

        // 凡例
        ctx.font = '11px sans-serif';
        ctx.strokeStyle = '#c8a96e'; ctx.lineWidth = 2.5;
        ctx.beginPath(); ctx.moveTo(PL+10, PT+15); ctx.lineTo(PL+40, PT+15); ctx.stroke();
        ctx.fillStyle = '#c8a96e'; ctx.fillText(`物理: Ψ = ${p.a_psi} − ${p.b_psi}·Φ²`, PL+48, PT+19);
        ctx.fillStyle = 'rgba(110,200,151,0.85)';
        ctx.beginPath();
        for (let k = 0; k < 5; k++) {
          const a1 = (k*2*Math.PI/5)-Math.PI/2; const a2 = ((k+0.5)*2*Math.PI/5)-Math.PI/2;
          ctx.lineTo(PL+240 + Math.cos(a1)*5, PT+15 + Math.sin(a1)*5);
          ctx.lineTo(PL+240 + Math.cos(a2)*2, PT+15 + Math.sin(a2)*2);
        }
        ctx.closePath(); ctx.fill();
        ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('訓練データを (Φ,Ψ) 変換', PL+252, PT+19);
      });
    }
    $('btn-psiphi').addEventListener('click', drawPsiPhi);

