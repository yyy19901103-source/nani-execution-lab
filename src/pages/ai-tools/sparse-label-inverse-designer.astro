            evalStatus.push(r.best_status);
            if (r.candidates[0]) {
              const m = r.candidates[0].checks;
              candX.push(m[0].pred); candY.push(m[1].pred); candStatus.push(r.best_status);
              if (state.lastResults.oracleResults && state.lastResults.oracleResults[ri]) {
                oracleX.push(state.lastResults.oracleResults[ri].truth.Q);
                oracleY.push(state.lastResults.oracleResults[ri].truth.P);
              }
            }
          });
        }
        const surgeX = [], surgeY = [];
        if (state.surge.length > 0) {
          [...state.surge].sort((a,b)=>a.Q-b.Q).forEach(s => { surgeX.push(s.Q); surgeY.push(s.P); });
        }
        const allX = [...yx, ...candX, ...evalX, ...oracleX, ...surgeX];
        const allY = [...yy, ...candY, ...evalY, ...oracleY, ...surgeY];
        let xMin = Math.min(...allX), xMax = Math.max(...allX);
        let yMin = Math.min(...allY), yMax = Math.max(...allY);
        const xP = (xMax-xMin)*0.15||1, yP = (yMax-yMin)*0.15||1;
        xMin -= xP; xMax += xP; yMin -= yP; yMax += yP;
        const PL=70, PR=30, PT=30, PB=50;
        const pW = W-PL-PR, pH = H-PT-PB;
        const sx = v => PL + (v-xMin)/(xMax-xMin)*pW;
        const sy = v => PT + (1-(v-yMin)/(yMax-yMin))*pH;
        ctx.strokeStyle = 'rgba(255,255,255,0.15)'; ctx.lineWidth = 1; ctx.strokeRect(PL, PT, pW, pH);
        ctx.strokeStyle = 'rgba(255,255,255,0.05)'; ctx.font = '11px monospace'; ctx.fillStyle = 'rgba(255,255,255,0.5)';
        for (let i = 0; i <= 5; i++) {
          const x = PL+pW*i/5, v1 = xMin+(xMax-xMin)*i/5;
          ctx.beginPath(); ctx.moveTo(x, PT); ctx.lineTo(x, PT+pH); ctx.stroke();
          ctx.fillText(v1.toFixed(2), x-18, PT+pH+16);
          const y = PT+pH*i/5, v2 = yMax-(yMax-yMin)*i/5;
          ctx.beginPath(); ctx.moveTo(PL, y); ctx.lineTo(PL+pW, y); ctx.stroke();
          ctx.fillText(v2.toFixed(2), 6, y+4);
        }
        ctx.fillStyle = '#c8a96e'; ctx.font = '12px sans-serif';
        ctx.fillText('流量 (m³/min)', W/2-40, H-12);
        ctx.save(); ctx.translate(16, H/2+40); ctx.rotate(-Math.PI/2); ctx.fillText('圧力 (bar)', 0, 0); ctx.restore();

        // サージ線
        if (surgeX.length >= 2) {
          ctx.strokeStyle = '#ff6b6b'; ctx.lineWidth = 2;
          ctx.beginPath();
          surgeX.forEach((x, i) => { if (i===0) ctx.moveTo(sx(x), sy(surgeY[i])); else ctx.lineTo(sx(x), sy(surgeY[i])); });
          ctx.stroke();
          ctx.fillStyle = '#ff6b6b';
          surgeX.forEach((x, i) => {
            const px = sx(x), py = sy(surgeY[i]);
            ctx.beginPath(); ctx.moveTo(px-4, py); ctx.lineTo(px, py-4); ctx.lineTo(px+4, py); ctx.lineTo(px, py+4); ctx.closePath(); ctx.fill();
          });
        }

        // 訓練点 ★
        ctx.fillStyle = 'rgba(200,169,110,0.7)';
        for (let i = 0; i < yx.length; i++) {
          const px = sx(yx[i]), py = sy(yy[i]);
          ctx.beginPath();
          for (let k = 0; k < 5; k++) {
            const a1 = (k*2*Math.PI/5)-Math.PI/2; const a2 = ((k+0.5)*2*Math.PI/5)-Math.PI/2;
            ctx.lineTo(px + Math.cos(a1)*5, py + Math.sin(a1)*5);
            ctx.lineTo(px + Math.cos(a2)*2, py + Math.sin(a2)*2);
          }
          ctx.closePath(); ctx.fill();
        }

        // シーケンス線
        if (state.lastResults && state.lastResults.sequence) {
          ctx.strokeStyle = 'rgba(110,200,151,0.5)'; ctx.lineWidth = 1.5; ctx.setLineDash([6,3]);
          ctx.beginPath();
          state.lastResults.sequence.forEach((idx, k) => {
            const px = sx(evalX[idx]), py = sy(evalY[idx]);
            if (k === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
          });
          ctx.stroke(); ctx.setLineDash([]);
        }

        // 評価点 ●
        for (let i = 0; i < evalX.length; i++) {
          const px = sx(evalX[i]), py = sy(evalY[i]);
          const col = evalStatus[i] === 'PASS' ? '#6ec897' : (evalStatus[i] === 'WARN' ? '#e8c97a' : '#ff6b6b');
          if (state.lastResults) {
            const tol = state.lastResults.results[i].target.tol / 100;
            const rx = Math.abs(sx(evalX[i] * (1+tol)) - sx(evalX[i]));
            const ry = Math.abs(sy(evalY[i] * (1+tol)) - sy(evalY[i]));
            ctx.strokeStyle = col + '55'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.ellipse(px, py, rx, ry, 0, 0, Math.PI*2); ctx.stroke();
          }
          ctx.fillStyle = col;
          ctx.beginPath(); ctx.arc(px, py, 6, 0, Math.PI*2); ctx.fill();
          ctx.fillStyle = 'rgba(255,255,255,0.9)'; ctx.font = 'bold 11px sans-serif';
          ctx.fillText(String(i+1), px+8, py-8);
        }

        // 推奨GP予測 ■
        for (let i = 0; i < candX.length; i++) {
          const px = sx(candX[i]), py = sy(candY[i]);
          const col = candStatus[i] === 'PASS' ? 'rgba(110,200,151,0.85)' : (candStatus[i] === 'WARN' ? 'rgba(232,201,122,0.85)' : 'rgba(255,107,107,0.85)');
          ctx.fillStyle = col; ctx.fillRect(px-4, py-4, 8, 8);
          ctx.strokeStyle = col; ctx.lineWidth = 1; ctx.setLineDash([3,3]);
          ctx.beginPath(); ctx.moveTo(px, py); ctx.lineTo(sx(evalX[i]), sy(evalY[i])); ctx.stroke();
          ctx.setLineDash([]);
        }
        // Oracle ◇
        for (let i = 0; i < oracleX.length; i++) {
          const px = sx(oracleX[i]), py = sy(oracleY[i]);
          ctx.strokeStyle = '#e8c97a'; ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(px, py-7); ctx.lineTo(px+7, py); ctx.lineTo(px, py+7); ctx.lineTo(px-7, py); ctx.closePath();
          ctx.stroke();
        }

        // 凡例
        ctx.font = '10px sans-serif';
        const ly = PT+14;
        ctx.fillStyle = 'rgba(200,169,110,0.7)';
        ctx.beginPath();
        for (let k = 0; k < 5; k++) {
          const a1 = (k*2*Math.PI/5)-Math.PI/2; const a2 = ((k+0.5)*2*Math.PI/5)-Math.PI/2;
          ctx.lineTo(PL+10 + Math.cos(a1)*5, ly + Math.sin(a1)*5);
          ctx.lineTo(PL+10 + Math.cos(a2)*2, ly + Math.sin(a2)*2);
        }
        ctx.closePath(); ctx.fill();
        ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('訓練データ', PL+20, ly+3);
        ctx.fillStyle = '#6ec897'; ctx.beginPath(); ctx.arc(PL+95, ly, 5, 0, Math.PI*2); ctx.fill();
        ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('評価点', PL+105, ly+3);
        ctx.fillStyle = 'rgba(110,200,151,0.85)'; ctx.fillRect(PL+155, ly-4, 8, 8);
        ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('GP予測', PL+168, ly+3);
        if (oracleX.length > 0) {
          ctx.strokeStyle = '#e8c97a'; ctx.lineWidth = 2; ctx.beginPath();
          ctx.moveTo(PL+220, ly-5); ctx.lineTo(PL+227, ly); ctx.lineTo(PL+220, ly+5); ctx.lineTo(PL+213, ly); ctx.closePath(); ctx.stroke();
          ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('物理真値', PL+233, ly+3);
        }
        if (surgeX.length >= 2) {
          ctx.strokeStyle = '#ff6b6b'; ctx.lineWidth = 2;
          ctx.beginPath(); ctx.moveTo(PL+295, ly); ctx.lineTo(PL+315, ly); ctx.stroke();
          ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('サージ線', PL+322, ly+3);
        }
        if (state.lastResults && state.lastResults.sequence) {
          ctx.strokeStyle = 'rgba(110,200,151,0.5)'; ctx.setLineDash([6,3]);
          ctx.beginPath(); ctx.moveTo(PL+390, ly); ctx.lineTo(PL+410, ly); ctx.stroke(); ctx.setLineDash([]);
          ctx.fillStyle = 'rgba(237,237,232,0.7)'; ctx.fillText('操作シーケンス', PL+417, ly+3);
        }
      }).catch(e => console.error(e));
    }
