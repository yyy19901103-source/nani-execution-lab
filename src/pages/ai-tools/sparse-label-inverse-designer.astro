        <div id="inverse-result" style="display:none;margin-top:1rem;overflow-x:auto;">
          <div id="overall-judgment" style="margin-bottom:0.8rem;padding:0.7rem 1rem;font-size:0.82rem;"></div>
          <div id="coverage-warnings" style="margin-bottom:0.8rem;"></div>
          <div id="candidates-table"></div>
          <div id="sequence-plan" style="margin-top:1rem;"></div>
        </div>
      </div>
    </section>

    <!-- ===== STEP 8: 性能マップ + 曲線/曲面可視化 ===== -->
    <section id="step8" class="phase-B" style="margin-bottom:2rem;opacity:0.4;pointer-events:none;">
      <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;">
        <span style="background:#c8a96e;color:#0c0c0e;padding:0.2rem 0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;">STEP 8</span>
        <h2 style="color:#edede8;font-size:1.05rem;font-weight:400;letter-spacing:0.1em;margin:0;">可視化（性能マップ + 物理曲線 + GP曲面 + 時系列）</h2>
      </div>
      <div style="background:#111114;border:1px solid rgba(255,255,255,0.06);padding:1.25rem;">

