      $('inverse-result').style.display = 'none';
      $('ae-result').style.display = 'none';
      ['train-status','inverse-status','ae-status'].forEach(clearLog);
      $('surge-tbody').innerHTML = '';
      $('eval-table-wrapper').innerHTML = '';
      $('physics-sliders').innerHTML = '';
      [2,3,4,5,6,7,8,9,10].forEach(n => setStep(n, false));
      updateDataStatus();
    });
    $('btn-confirm-mapping').addEventListener('click', confirmMapping);
