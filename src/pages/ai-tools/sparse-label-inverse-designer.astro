    if pp is not None:
        _phys_py = {
            'N': int(pp['N']),
            'q_max': float(pp['q_max']),
            'alphas': [float(x) for x in pp['alphas']],
            'gammas': [float(x) for x in pp['gammas']],
            'Phi_norm': float(pp['Phi_norm']),
            'a_psi': float(pp['a_psi']),
            'b_psi': float(pp['b_psi']),
            'H_norm': float(pp['H_norm']),
            'T_in': float(pp['T_in']),
            'kappa': float(pp['kappa']),
            'P_atm': float(pp['P_atm']),
            'useRPM': bool(pp['useRPM']),
            'rpm_design': float(pp['rpm_design']),
        }
