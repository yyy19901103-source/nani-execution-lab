      if (!state.lastResults) { alert('先に逆推定を実行してください'); return; }
      const r = state.lastResults;
      const tr = state.trainResult;
      const now = new Date().toLocaleString('ja-JP');
      let html = `<!DOCTYPE html><html lang="ja"><head><meta charset="UTF-8"><title>PTC10適合性レポート</title>
<style>
body { font-family: 'Hiragino Sans', 'Meiryo', sans-serif; max-width: 980px; margin: 2rem auto; padding: 1rem; color: #222; line-height: 1.7; }
h1 { border-bottom: 3px solid #c8a96e; padding-bottom: 0.5rem; }
h2 { color: #6c5a3a; margin-top: 2rem; border-left: 4px solid #c8a96e; padding-left: 0.6rem; }
table { width: 100%; border-collapse: collapse; margin: 0.8rem 0; font-size: 0.9rem; }
