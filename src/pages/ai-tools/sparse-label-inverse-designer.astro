                      '温度_目標', '温度_予測', '温度_誤差%', '温度_判定',
                      'サージ余裕', '総合判定'];
      const rows = r.results.map(rr => {
        const c = rr.candidates[0]; if (!c) return null;
        const row = [rr.idx, rr.label];
        c.u.forEach(v => row.push(v));
        c.checks.forEach(ch => row.push(ch.target, ch.pred, ch.err_pct, ch.ok ? 'OK' : 'NG'));
