</style></head><body>`;
      html += `<h1>コンプレッサ性能試験 適合性レポート</h1>`;
      html += `<div class="meta">作成日時: ${now}<br>規格: ASME PTC 10 / API 617<br>ツール: Sparse-Label Inverse Designer v5.1<br>モデルモード: ${tr.mode === 'residual' ? '残差学習 (物理+GP)' : '直接GP'} ${tr.audit.use_ae ? '+ AE事前学習' : ''}</div>`;
      html += `<h2>1. 試験概要</h2>`;
      html += `<table><tr><th>項目</th><th>値</th></tr>`;
      html += `<tr><td>評価点数</td><td>${r.n_points}</td></tr>`;
      html += `<tr><td>PASS / WARN / FAIL</td><td><span class="pass">${r.overall_pass}</span> / <span class="warn">${r.overall_warn}</span> / <span class="fail">${r.overall_fail}</span></td></tr>`;
      html += `<tr><td>訓練データ数</td><td>${tr.n_train} 行（除外 ${tr.n_skipped}）</td></tr>`;
      html += `<tr><td>特徴量次元</td><td>${tr.n_features} (u=${tr.n_u_total} + 事前窓=${tr.n_pre}${tr.n_ae?' + AE='+tr.n_ae:''})</td></tr>`;
      html += `</table>`;
      html += `<h2>2. LOO-CV 精度</h2>`;
      html += `<table><tr><th>y</th><th>RMSE</th><th>MAE</th><th>相対誤差%</th><th>95%CI被覆</th></tr>`;
      tr.loo.forEach(l => {
        html += `<tr><td>${l.target}</td><td>${l.loo_rmse}</td><td>${l.loo_mae}</td><td>${l.loo_rel_err_pct}%</td><td>${(l.loo_95pct_coverage*100).toFixed(0)}%</td></tr>`;
      });
      html += `</table>`;
      html += `<h2>3. 各評価点の判定</h2>`;
      r.results.forEach(rr => {
        const c = rr.candidates[0]; if (!c) return;
        const cls = rr.best_status === 'PASS' ? 'pass' : (rr.best_status === 'WARN' ? 'warn' : 'fail');
        html += `<h3>#${rr.idx} ${rr.label} <span class="${cls}">[${rr.best_status}]</span></h3>`;
        html += `<p><strong>推奨バルブ操作:</strong> `;
        c.u.forEach((v, i) => { html += `${r.u_names_full[i]}=${v}${c.u_ci?` ±${c.u_ci[i]}`:''} `; });
        html += `</p>`;
        html += `<table><tr><th>項目</th><th>目標</th><th>予測±std</th><th>誤差%</th><th>判定(±${rr.target.tol}%)</th></tr>`;
        c.checks.forEach(ch => {
          html += `<tr><td>${ch.name}</td><td>${ch.target}</td><td>${ch.pred} ± ${ch.std}</td><td>${ch.err_pct}%</td><td class="${ch.ok?'pass':'fail'}">${ch.ok?'OK':'NG'}</td></tr>`;
        });
        html += `</table>`;
        if (c.surge_margin !== null) html += `<p>サージ余裕: <strong>${c.surge_margin}</strong> ${c.surge_safe ? '(安全側)' : '(境界に近い)'}</p>`;
      });
      html += `<h2>4. 操作シーケンス推奨</h2>`;
      if (r.sequence) {
        html += `<p>${r.sequence.map(idx => `#${r.results[idx].idx} ${r.results[idx].label}`).join(' → ')}</p>`;
      } else html += `<p>シーケンス計画は実行されませんでした。</p>`;
      html += `<h2>5. 整合性ガード遵守確認</h2>`;
      html += `<p>本レポートにおける推奨バルブ操作は、すべて<strong>循環ループ + 吸込側</strong>のバルブに限定されています。吐出側を操作対象とした推奨は含まれていません（性能試験の信頼性確保のため）。</p>`;
      html += `<hr><p style="color:#888;font-size:0.8rem;">本レポートはブラウザ完結ツールで生成されています。データは外部送信されていません。</p>`;
      html += `</body></html>`;
      const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `PTC10_report_${Date.now()}.html`; a.click();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      $('export-status').textContent = '✓ レポートHTML出力完了';
      audit('report_exported', {});
    });

    $('btn-export-audit').addEventListener('click', () => {
