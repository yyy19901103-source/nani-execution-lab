          <button class="viz-tab" data-target="viz-psiphi" style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.4rem 0.9rem;font-size:0.75rem;cursor:pointer;font-family:inherit;">② 物理特性曲線 (Ψ-Φ)</button>
          <button class="viz-tab" data-target="viz-contour" style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.4rem 0.9rem;font-size:0.75rem;cursor:pointer;font-family:inherit;">③ GP予測等高線</button>
          <button class="viz-tab" data-target="viz-timeseries" style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.4rem 0.9rem;font-size:0.75rem;cursor:pointer;font-family:inherit;">④ センサー時系列</button>
        </div>

        <!-- ① 性能マップ -->
        <div id="viz-perfmap" class="viz-panel">
          <button id="btn-plot" style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.4rem 1rem;font-size:0.78rem;cursor:pointer;font-family:inherit;margin-bottom:1rem;">📊 性能マップ更新</button>
          <canvas id="perfmap" width="1100" height="600" style="background:#0a0a0c;border:1px solid rgba(255,255,255,0.06);width:100%;height:auto;display:block;"></canvas>
          <div style="margin-top:0.6rem;font-size:0.7rem;color:rgba(255,255,255,0.5);">★訓練データ ●評価点(緑/黄/赤) ■推奨u→GP予測 ◆物理真値 ↗操作シーケンス ━サージ線</div>
        </div>

        <!-- ② 物理特性曲線 -->
