        </table>
      </div>
    </section>

    <!-- ===== STEP 6: 評価点 ===== -->
    <section id="step6" class="phase-B" style="margin-bottom:2rem;opacity:0.4;pointer-events:none;">
      <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;">
        <span style="background:#c8a96e;color:#0c0c0e;padding:0.2rem 0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;">STEP 6</span>
        <h2 style="color:#edede8;font-size:1.05rem;font-weight:400;letter-spacing:0.1em;margin:0;">性能評価点テーブル（PTC10/API617）</h2>
      </div>
      <div style="background:#111114;border:1px solid rgba(255,255,255,0.06);padding:1.25rem;">
