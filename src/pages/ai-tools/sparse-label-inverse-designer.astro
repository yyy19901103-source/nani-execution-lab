          <div id="physics-sliders" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:0.6rem;"></div>
          <div id="physics-formula" style="margin-top:0.8rem;padding:0.6rem 0.8rem;background:#0a0a0c;border:1px dashed rgba(110,200,151,0.3);font-family:'SF Mono',monospace;font-size:0.7rem;color:rgba(237,237,232,0.75);"></div>
        </div>
      </div>
    </section>

    <!-- ===== STEP 3: AE 事前学習 ===== -->
    <section id="step3" class="phase-A" style="margin-bottom:2rem;opacity:0.4;pointer-events:none;">
      <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;">
        <span style="background:#c8a96e;color:#0c0c0e;padding:0.2rem 0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;">STEP 3</span>
        <h2 style="color:#edede8;font-size:1.05rem;font-weight:400;letter-spacing:0.1em;margin:0;">AE 事前学習（dense センサー全活用）</h2>
      </div>

      <div style="background:#111114;border:1px solid rgba(255,255,255,0.06);padding:1.25rem;">
        <label style="display:flex;align-items:center;gap:0.6rem;margin-bottom:0.8rem;color:#edede8;font-size:0.85rem;">
          <input type="checkbox" id="use-ae" checked />
          <strong>オートエンコーダ事前学習を使用</strong>
          <span style="color:rgba(255,255,255,0.5);font-size:0.72rem;">— センサーストリーム全体から表現学習</span>
          <span class="help-tip" data-tip="dense センサーデータ（数万秒の時系列）を 75%オーバーラップでセグメント化し、MLPRegressor（隠れ層 16→latent→16）で自己回帰訓練。中間層から潜在ベクトルを取り出し、操作点の特徴量に追加します。これにより dense センサーの実質97%カバレッジを達成。OFF にすると AE 抜きで GP のみ。">?</span>
        </label>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:0.8rem;font-size:0.75rem;color:rgba(237,237,232,0.7);">
          <label>セグメント長 (sec):
            <input type="number" id="ae-seg" value="30" min="5" max="120" style="width:3.5rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" />
          </label>
          <label>潜在次元:
            <input type="number" id="ae-latent" value="4" min="2" max="16" style="width:3rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" />
          </label>
          <label>反復:
            <input type="number" id="ae-iter" value="200" min="50" max="1000" step="50" style="width:4rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" />
          </label>
        </div>
        <button id="btn-ae" style="background:transparent;border:1px solid rgba(110,200,151,0.4);color:#6ec897;padding:0.5rem 1.2rem;font-size:0.78rem;cursor:pointer;font-family:inherit;letter-spacing:0.1em;">▶ AE 事前学習を実行</button>
        <span class="help-tip" data-tip="センサーストリームから AE を訓練します。初回は Pyodide + sklearn のダウンロードで30秒〜2分かかります（2回目以降はキャッシュで高速）。3660秒のサンプルで約520セグメント、訓練時間1秒前後。完了すると STEP 4 GP訓練 に進めます。">?</span>
        <span id="ae-elapsed" style="margin-left:0.7rem;color:rgba(255,255,255,0.4);font-size:0.72rem;"></span>
        <div id="ae-status" style="margin-top:0.7rem;font-family:'SF Mono',monospace;font-size:0.72rem;line-height:1.7;color:rgba(237,237,232,0.85);"></div>
        <div id="ae-result" style="display:none;margin-top:0.7rem;background:#0a0a0c;border:1px solid rgba(110,200,151,0.2);padding:0.8rem 1rem;font-size:0.74rem;color:rgba(237,237,232,0.9);"></div>
      </div>
    </section>

    <!-- ===== STEP 4: GP訓練 + LOO-CV ===== -->
    <section id="step4" class="phase-A" style="margin-bottom:2rem;opacity:0.4;pointer-events:none;">
      <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;">
        <span style="background:#c8a96e;color:#0c0c0e;padding:0.2rem 0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;">STEP 4</span>
        <h2 style="color:#edede8;font-size:1.05rem;font-weight:400;letter-spacing:0.1em;margin:0;">時間窓集約 + GP（残差/直接）訓練 + LOO-CV</h2>
      </div>

      <div style="background:#111114;border:1px solid rgba(255,255,255,0.06);padding:1.25rem;">
        <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;margin-bottom:1rem;font-size:0.75rem;color:rgba(237,237,232,0.7);">
          <label>整定窓(sec): <input type="number" id="opt-settle" value="60" min="10" max="300" style="width:4rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" /></label>
          <label>整定待ち(sec): <input type="number" id="opt-settle-wait" value="20" min="0" max="120" style="width:4rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" /></label>
          <label>事前窓(sec): <input type="number" id="opt-pre" value="30" min="0" max="120" style="width:4rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" /></label>
          <label>n_restarts: <input type="number" id="opt-restarts" value="8" min="1" max="20" style="width:3rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" /></label>
        </div>
        <button id="btn-train" style="background:#c8a96e;color:#0c0c0e;border:none;padding:0.6rem 1.6rem;font-size:0.85rem;font-weight:600;cursor:pointer;font-family:inherit;letter-spacing:0.1em;">▶ GP訓練 + LOO-CV</button>
        <span class="help-tip" data-tip="各操作 t について [整定待ち] 後の [整定窓] で y を平均化（aleatoric ノイズ低減）、[事前窓] の統計を u 特徴量に追加。物理ONなら残差GP、OFFなら直接GP。LOO-CV（Leave-One-Out 交差検証）で 12点での honest 精度（RMSE / 相対誤差% / 95%信頼区間被覆率）を計算。約6〜10秒。">?</span>
        <span id="train-elapsed" style="margin-left:0.7rem;color:rgba(255,255,255,0.4);font-size:0.72rem;"></span>

        <div id="train-status" style="margin-top:0.8rem;font-family:'SF Mono',monospace;font-size:0.72rem;line-height:1.7;color:rgba(237,237,232,0.85);"></div>
        <div id="train-result" style="display:none;margin-top:1rem;background:#0a0a0c;border:1px solid rgba(200,169,110,0.2);padding:1rem;">
          <div style="color:#c8a96e;font-size:0.65rem;letter-spacing:0.2em;margin-bottom:0.6rem;">TRAINING + LOO-CV</div>
          <div id="train-summary" style="font-size:0.78rem;color:rgba(237,237,232,0.9);line-height:1.7;"></div>
        </div>
      </div>
    </section>

    <!-- ===== STEP 5: サージ線 ===== -->
    <section id="step5" class="phase-B" style="margin-bottom:2rem;opacity:0.4;pointer-events:none;">
      <div style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;">
        <span style="background:#c8a96e;color:#0c0c0e;padding:0.2rem 0.6rem;font-size:0.7rem;font-weight:700;letter-spacing:0.15em;">STEP 5</span>
        <h2 style="color:#edede8;font-size:1.05rem;font-weight:400;letter-spacing:0.1em;margin:0;">設計サージ線</h2>
      </div>
      <div style="background:#111114;border:1px solid rgba(255,255,255,0.06);padding:1.25rem;">
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center;margin-bottom:1rem;">
          <button id="btn-surge-add" style="background:transparent;border:1px solid rgba(200,169,110,0.4);color:#c8a96e;padding:0.4rem 0.9rem;font-size:0.75rem;cursor:pointer;font-family:inherit;">+ 行追加</button>
          <label style="font-size:0.75rem;color:rgba(237,237,232,0.7);margin-left:auto;">余裕係数:
            <input type="number" id="surge-margin" value="1.10" min="1.00" max="1.50" step="0.01" style="width:4rem;background:#0a0a0c;border:1px solid rgba(255,255,255,0.15);color:#edede8;padding:0.25rem;margin-left:0.3rem;font-family:inherit;font-size:0.75rem;" />
          </label>
        </div>
        <table style="width:100%;border-collapse:collapse;font-size:0.78rem;">
          <thead><tr>
            <th style="text-align:left;padding:0.4rem 0.6rem;border-bottom:1px solid rgba(200,169,110,0.3);color:#c8a96e;">#</th>
            <th style="text-align:right;padding:0.4rem 0.6rem;border-bottom:1px solid rgba(200,169,110,0.3);color:#c8a96e;">サージ流量</th>
            <th style="text-align:right;padding:0.4rem 0.6rem;border-bottom:1px solid rgba(200,169,110,0.3);color:#c8a96e;">サージ圧力</th>
            <th style="padding:0.4rem 0.6rem;border-bottom:1px solid rgba(200,169,110,0.3);"></th>
          </tr></thead>
