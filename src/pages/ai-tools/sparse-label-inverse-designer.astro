    // ============================================================
    // STEP 10: モデル保存/読込 (F11 IndexedDB)
    // ============================================================
    const DB_NAME = 'compressor-models'; const STORE = 'models';
    function openDB() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(DB_NAME, 1);
        req.onupgradeneeded = () => req.result.createObjectStore(STORE, { keyPath: 'name' });
        req.onsuccess = () => resolve(req.result);
        req.onerror = () => reject(req.error);
      });
    }
    async function saveModel() {
      if (!state.trained) { alert('先に GP を訓練してください'); return; }
      const name = $('model-name').value.trim();
      if (!name) { alert('モデル名を入力してください'); return; }
      // モデルは Pyodide 側にあるため、JS で保持できる「メタ情報 + サンプル」のみ保存
      const data = {
        name, savedAt: new Date().toISOString(),
        mapping: state.mapping,
        physicsParams: state.physicsParams,
        surge: state.surge,
        evalPoints: state.evalPoints,
        lastResults: state.lastResults,
        trainResult: state.trainResult,
        auditLog: state.auditLog,
      };
      try {
        const db = await openDB();
        const tx = db.transaction(STORE, 'readwrite');
        tx.objectStore(STORE).put(data);
        await new Promise((res, rej) => { tx.oncomplete = res; tx.onerror = () => rej(tx.error); });
        $('export-status').textContent = `✓ モデル「${name}」を保存`;
        audit('model_saved', { name });
        listModels();
      } catch (e) { alert('保存失敗: ' + e); }
    }
    async function listModels() {
      try {
        const db = await openDB();
        const tx = db.transaction(STORE, 'readonly');
        const req = tx.objectStore(STORE).getAll();
        const all = await new Promise((res, rej) => { req.onsuccess = () => res(req.result); req.onerror = () => rej(req.error); });
        if (all.length === 0) { $('model-list').textContent = '保存済みモデルなし'; return; }
        let html = '<table style="width:100%;border-collapse:collapse;font-size:0.74rem;"><tr style="color:#c8a96e;"><th style="text-align:left;padding:0.3rem 0.6rem;">名前</th><th style="text-align:left;padding:0.3rem 0.6rem;">保存日時</th><th></th></tr>';
        all.forEach(m => {
          html += `<tr><td style="padding:0.3rem 0.6rem;border-bottom:1px solid rgba(255,255,255,0.05);">${escapeHtml(m.name)}</td>
            <td style="padding:0.3rem 0.6rem;border-bottom:1px solid rgba(255,255,255,0.05);">${new Date(m.savedAt).toLocaleString('ja-JP')}</td>
            <td style="padding:0.3rem 0.6rem;border-bottom:1px solid rgba(255,255,255,0.05);">
              <button class="m-load" data-name="${escapeAttr(m.name)}" style="background:transparent;border:1px solid rgba(110,200,151,0.4);color:#6ec897;padding:0.2rem 0.6rem;font-size:0.7rem;cursor:pointer;">読込</button>
              <button class="m-del" data-name="${escapeAttr(m.name)}" style="background:transparent;border:1px solid rgba(255,107,107,0.3);color:#ff6b6b;padding:0.2rem 0.6rem;font-size:0.7rem;cursor:pointer;">削除</button>
            </td></tr>`;
        });
        html += '</table>';
        $('model-list').innerHTML = html;
        document.querySelectorAll('.m-load').forEach(b => b.addEventListener('click', async e => {
          await loadModel(e.target.dataset.name);
        }));
        document.querySelectorAll('.m-del').forEach(b => b.addEventListener('click', async e => {
          if (!confirm('削除しますか?')) return;
          const db = await openDB();
          const tx = db.transaction(STORE, 'readwrite');
          tx.objectStore(STORE).delete(e.target.dataset.name);
          await new Promise(r => tx.oncomplete = r);
          listModels();
        }));
      } catch (e) { $('model-list').textContent = '読込失敗: ' + e; }
    }
    async function loadModel(name) {
      try {
        const db = await openDB();
        const tx = db.transaction(STORE, 'readonly');
        const req = tx.objectStore(STORE).get(name);
        const m = await new Promise((res, rej) => { req.onsuccess = () => res(req.result); req.onerror = () => rej(req.error); });
        if (!m) { alert('見つかりません'); return; }
        state.mapping = m.mapping;
        state.physicsParams = m.physicsParams;
        state.surge = m.surge || [];
        state.evalPoints = m.evalPoints || [];
        state.lastResults = m.lastResults;
        state.trainResult = m.trainResult;
        state.auditLog = m.auditLog || [];
        renderPhysicsSliders();
        renderSurgeTable();
        renderEvalTable();
        if (state.lastResults) renderInverseResult(state.lastResults);
        $('export-status').textContent = `✓ モデル「${name}」を読込（再訓練を推奨）`;
        audit('model_loaded', { name });
      } catch (e) { alert('読込失敗: ' + e); }
    }
    $('btn-save-model').addEventListener('click', saveModel);
    $('btn-load-list').addEventListener('click', listModels);

    // ============================================================
    // プライバシーバナー
    // ============================================================
    $('verify-privacy').addEventListener('click', () => {
      const d = $('privacy-detail');
      d.style.display = d.style.display === 'none' ? 'block' : 'none';
    });

    // 一発本番モードのトグル動作
    $('one-shot-mode').addEventListener('change', e => {
      const on = e.target.checked;
      $('one-shot-detail').style.display = on ? 'block' : 'none';
      if (on) {
        // 全機能を最大安全側に
        if ($('use-physics')) $('use-physics').checked = true;
        if ($('use-ae')) $('use-ae').checked = true;
        if ($('opt-sensitivity')) $('opt-sensitivity').checked = true;
        if ($('opt-sequence')) $('opt-sequence').checked = true;
        if ($('opt-multistart')) $('opt-multistart').value = '50';
        if ($('default-tol')) $('default-tol').value = '3';
        // 既存評価点の公差も厳格化
        state.evalPoints.forEach(p => { if (p.tol > 3) p.tol = 3; });
        if (state.evalPoints.length > 0) renderEvalTable();
        // n_restartsも増強
        if ($('opt-restarts')) $('opt-restarts').value = '15';
        audit('one_shot_mode_enabled', {});
      }
    });

    // ============================================================
    // 3 フェーズタブ切替
    // ============================================================
    const phaseDescs = {
      A: '<strong style="color:#c8a96e;">Phase A · 事前モデル訓練</strong> — 過去の試運転①データを使って GP+物理モデルを訓練。試運転当日の前に経験者が一度だけ実行。',
      B: '<strong style="color:#c8a96e;">Phase B · バルブ開度予測</strong> — 訓練済みモデルで性能評価点 → バルブ開度を推定。試運転当日に初心者が実行。',
      C: '<strong style="color:#ff8c5a;">Phase C · 予実差確認</strong> — 試運転②の実機計測値を取込み、GP予測との誤差を可視化。次回モデル校正に使用。',
      ALL: '<strong style="color:rgba(255,255,255,0.6);">全表示</strong> — 全 STEP を一括表示（デバッグ・全体俯瞰用）。',
    };
    function setPhase(ph) {
      document.querySelectorAll('.phase-tab').forEach(b => {
        const active = b.dataset.phase === ph;
        b.style.background = active ? '#c8a96e' : 'rgba(200,169,110,0.15)';
        b.style.color = active ? '#0c0c0e' : '#c8a96e';
        b.style.fontWeight = active ? '600' : '400';
        b.style.border = active ? 'none' : '1px solid rgba(200,169,110,0.4)';
      });
      const showA = (ph === 'A' || ph === 'ALL');
      const showB = (ph === 'B' || ph === 'ALL');
      const showC = (ph === 'C' || ph === 'ALL');
      document.querySelectorAll('.phase-A').forEach(s => s.style.display = showA ? '' : 'none');
      document.querySelectorAll('.phase-B').forEach(s => s.style.display = showB ? '' : 'none');
      document.querySelectorAll('.phase-C').forEach(s => s.style.display = showC ? '' : 'none');
      const desc = $('phase-desc'); if (desc) desc.innerHTML = phaseDescs[ph] || '';
      try { localStorage.setItem('compressor_phase', ph); } catch (_) {}
    }
    document.querySelectorAll('.phase-tab').forEach(b => {
      b.addEventListener('click', () => setPhase(b.dataset.phase));
    });
    try { setPhase(localStorage.getItem('compressor_phase') || 'A'); } catch (_) { setPhase('A'); }

    // ============================================================
    // STEP 11: 試運転②実機データ → 予実差ビュー
    // ============================================================
    state.actualRun2 = null;  // {rows: [{eval_name,rpm,u1,u2,u3,y1,y2,y3}, ...]}

    $('btn-actual-load')?.addEventListener('click', async () => {
      const f = $('actual-csv')?.files?.[0];
      if (!f) { alert('CSVファイルを選択してください'); return; }
      try {
        const buf = await f.arrayBuffer();
        const text = decodeAuto(new Uint8Array(buf));
        const lines = text.split(/\r?\n/).filter(l => l.trim());
        const header = lines[0].split(',').map(s => s.trim());
        const rows = lines.slice(1).map(line => {
          const cells = line.split(',').map(s => s.trim());
          const obj = {};
          header.forEach((h, i) => obj[h] = cells[i]);
          return obj;
        });
        // 必須列チェック
        const need = ['eval_name'];
        for (const k of need) {
          if (!header.includes(k)) throw new Error(`必須列 ${k} がありません`);
        }
        state.actualRun2 = { header, rows };
        $('actual-status').textContent = `✓ ${rows.length} 行取込`;
        $('actual-status').style.color = '#6ec897';
        $('btn-diff-plot').disabled = false;
        $('btn-diff-plot').style.opacity = '1';
        audit('actual_run2_loaded', { n: rows.length });
      } catch (e) {
        $('actual-status').textContent = '❌ ' + e.message;
        $('actual-status').style.color = '#ff6b6b';
      }
    });

    $('btn-diff-plot')?.addEventListener('click', async () => {
      if (!state.actualRun2) { alert('先に実機データを取込んでください'); return; }
      if (!state.trained) { alert('Phase A で GP を訓練してください'); return; }
      if (state.evalPoints.length === 0) { alert('Phase B で評価点を登録してください'); return; }
      const btn = $('btn-diff-plot'); btn.disabled = true; btn.textContent = '⏳ 計算中...';
      try {
        // 各実機行について GP で再予測し、差分を計算
        const actual = state.actualRun2.rows;
        // y 列の自動検出
        const hdr = state.actualRun2.header;
        // y 列: y で始まる、actual を含む、または流量/圧力/効率名を含むもの（u 列・rpm・eval_name は除外）
        const isUish = h => /^u\d+/.test(h) || /valve/i.test(h) || /^rpm$/i.test(h) || (/_pct$/i.test(h) && !/actual/i.test(h) && !/eta/i.test(h));
        const yCols = hdr.filter(h => h !== 'eval_name' && !isUish(h) && /^(y\d+|.*actual.*|.*Q.*|.*dP.*|.*eta.*|.*flow.*|.*press.*|.*temp.*)/i.test(h));
        // u 列
        // u 列: u\d で始まる、valve を含む、rpm、または _pct で終わるが actual/eta を含まないもの
        const uCols = hdr.filter(h => isUish(h));

        state.pyodide.globals.set('actual_rows', actual.map(r => {
          const o = {};
          for (const k in r) o[k] = isFinite(parseFloat(r[k])) ? parseFloat(r[k]) : r[k];
          return o;
        }));
        state.pyodide.globals.set('eval_pts', state.evalPoints);
        state.pyodide.globals.set('y_cols', yCols);
        state.pyodide.globals.set('u_cols', uCols);

        const code = `
import numpy as np, json
actual = actual_rows.to_py()
yc = y_cols.to_py()
uc = u_cols.to_py()
# u 列 → _valve_names と一致するものを抽出
n_u = len(_valve_names) + (1 if _use_rpm else 0)
u_full_names = _valve_names + (['rpm'] if _use_rpm else [])
results = []
for r in actual:
    name = r.get('eval_name','?')
    # u を構築
    u = np.zeros(n_u)
    for i, un in enumerate(u_full_names):
        # 列名にバルブ名 or rpm を含むもの
        match = None
        for k in r:
            if un.lower() in str(k).lower() or (un=='rpm' and 'rpm' in str(k).lower()):
                if isinstance(r[k], (int,float)): match = float(r[k]); break
        if match is not None: u[i] = match
    # X 構築
    parts = [u, np.array(_pre_default)]
    if len(_ae_default)>0: parts.append(np.array(_ae_default))
    if len(_embed_default)>0: parts.append(np.array(_embed_default))
    X = np.concatenate(parts).reshape(1,-1)
    Xs = _scaler.transform(X)
    y_pred = []
    y_std = []
    for m in _models:
        mu, sd = m.predict(Xs, return_std=True)
        y_pred.append(float(mu[0])); y_std.append(float(sd[0]))
    # actual y 抽出（数値かつ y1/y2/y3 や *actual* を含む列）
    y_act = []
    for yn in _y_names:
        v = None
        for k in r:
            if yn.lower() in str(k).lower() and isinstance(r[k], (int,float)):
                v = float(r[k]); break
        y_act.append(v)
    results.append({
        'name': str(name),
        'y_pred': y_pred, 'y_std': y_std,
        'y_actual': y_act,
        'y_names': list(_y_names),
    })
out = {'rows': results, 'y_names': list(_y_names)}
json.dumps(out)
`;
        const resStr = await state.pyodide.runPythonAsync(code);
        const d = JSON.parse(resStr);

        // 表
        let tbl = '<table style="width:100%;border-collapse:collapse;font-size:0.74rem;color:rgba(237,237,232,0.85);"><thead><tr style="border-bottom:1px solid rgba(255,255,255,0.15);color:#c8a96e;">';
        tbl += '<th style="text-align:left;padding:0.4rem;">評価点</th>';
        d.y_names.forEach(yn => {
          tbl += `<th style="padding:0.4rem;">${yn} 予測</th><th style="padding:0.4rem;">${yn} 実測</th><th style="padding:0.4rem;">残差</th><th style="padding:0.4rem;">±σ</th>`;
        });
        tbl += '</tr></thead><tbody>';
        const allResiduals = d.y_names.map(() => []);
        d.rows.forEach(r => {
          tbl += `<tr style="border-bottom:1px solid rgba(255,255,255,0.05);"><td style="padding:0.4rem;">${r.name}</td>`;
          r.y_pred.forEach((yp, i) => {
            const ya = r.y_actual[i];
            const resid = (ya != null) ? ya - yp : null;
            if (resid !== null) allResiduals[i].push(resid);
            const within = (resid != null && Math.abs(resid) < 2 * r.y_std[i]);
            const color = within ? '#6ec897' : (resid == null ? 'rgba(255,255,255,0.4)' : '#ff8c5a');
            tbl += `<td style="padding:0.4rem;color:rgba(255,255,255,0.7);">${yp.toFixed(2)}</td>`;
            tbl += `<td style="padding:0.4rem;color:rgba(255,255,255,0.7);">${ya != null ? ya.toFixed(2) : '—'}</td>`;
            tbl += `<td style="padding:0.4rem;color:${color};font-weight:600;">${resid != null ? (resid>=0?'+':'')+resid.toFixed(2) : '—'}</td>`;
            tbl += `<td style="padding:0.4rem;color:rgba(255,255,255,0.5);">±${r.y_std[i].toFixed(2)}</td>`;
          });
          tbl += '</tr>';
        });
        tbl += '</tbody></table>';
        $('diff-table-wrap').innerHTML = tbl;

        // メトリクス
        let metrics = '<div style="display:flex;gap:1.5rem;flex-wrap:wrap;">';
        d.y_names.forEach((yn, i) => {
          const arr = allResiduals[i];
          if (arr.length === 0) return;
          const bias = arr.reduce((a, b) => a + b, 0) / arr.length;
          const rmse = Math.sqrt(arr.reduce((a, b) => a + b * b, 0) / arr.length);
          const within2sd = d.rows.filter(r => r.y_actual[i] != null && Math.abs(r.y_actual[i] - r.y_pred[i]) < 2 * r.y_std[i]).length;
          metrics += `<div style="background:rgba(200,169,110,0.05);border-left:3px solid #c8a96e;padding:0.6rem 0.9rem;">
            <div style="color:#c8a96e;font-size:0.65rem;letter-spacing:0.2em;">${yn}</div>
            <div style="margin-top:0.3rem;">バイアス: <strong style="color:${Math.abs(bias) < rmse / 2 ? '#6ec897' : '#ff8c5a'};">${bias >= 0 ? '+' : ''}${bias.toFixed(3)}</strong></div>
            <div>RMSE: <strong>${rmse.toFixed(3)}</strong></div>
            <div>2σ内: <strong style="color:${within2sd / arr.length > 0.8 ? '#6ec897' : '#ff8c5a'};">${within2sd}/${arr.length}</strong></div>
          </div>`;
        });
        metrics += '</div>';
        metrics += '<div style="margin-top:0.8rem;color:rgba(255,255,255,0.5);font-size:0.72rem;">※ バイアス: 系統誤差（モデルが平均的にずれている方向）／ RMSE: バラつきの大きさ／ 2σ内: GP の予測区間に実測が入った割合（0.95 以上が理想）</div>';
        $('diff-metrics').innerHTML = metrics;

        // 散布図（予測 vs 実測）
        const cv = $('diff-canvas'); const ctx = cv.getContext('2d');
        const W = cv.width, H = cv.height;
        ctx.fillStyle = '#0a0a0c'; ctx.fillRect(0, 0, W, H);
        const nY = d.y_names.length;
        const sw = W / nY;
        const PT = 30, PB = 50, PL = 50, PR = 20;
        d.y_names.forEach((yn, i) => {
          const x0 = i * sw + PL;
          const y0 = PT;
          const pW = sw - PL - PR;
          const pH = H - PT - PB;
          // データ範囲
          const vals = d.rows.flatMap(r => [r.y_pred[i], r.y_actual[i]]).filter(v => v != null);
          if (vals.length === 0) return;
          const vmin = Math.min(...vals), vmax = Math.max(...vals);
          const pad = (vmax - vmin) * 0.1 || 1;
          const lo = vmin - pad, hi = vmax + pad;
          // 軸
          ctx.strokeStyle = 'rgba(255,255,255,0.2)'; ctx.lineWidth = 1;
          ctx.strokeRect(x0, y0, pW, pH);
          // y=x 線
          ctx.strokeStyle = 'rgba(200,169,110,0.5)'; ctx.setLineDash([4, 4]);
          ctx.beginPath(); ctx.moveTo(x0, y0 + pH); ctx.lineTo(x0 + pW, y0); ctx.stroke();
          ctx.setLineDash([]);
          // 点
          d.rows.forEach(r => {
            const ya = r.y_actual[i]; const yp = r.y_pred[i];
            if (ya == null) return;
            const px = x0 + (yp - lo) / (hi - lo) * pW;
            const py = y0 + pH - (ya - lo) / (hi - lo) * pH;
            // ±2σ エラーバー（横方向）
            const sd = r.y_std[i];
            const sxl = x0 + (yp - 2 * sd - lo) / (hi - lo) * pW;
            const sxr = x0 + (yp + 2 * sd - lo) / (hi - lo) * pW;
            ctx.strokeStyle = 'rgba(110,200,151,0.4)'; ctx.lineWidth = 1;
            ctx.beginPath(); ctx.moveTo(sxl, py); ctx.lineTo(sxr, py); ctx.stroke();
            const within = Math.abs(ya - yp) < 2 * sd;
            ctx.fillStyle = within ? '#6ec897' : '#ff8c5a';
            ctx.beginPath(); ctx.arc(px, py, 5, 0, 2 * Math.PI); ctx.fill();
            ctx.strokeStyle = '#000'; ctx.lineWidth = 1; ctx.stroke();
          });
          // ラベル
          ctx.fillStyle = '#c8a96e'; ctx.font = 'bold 12px sans-serif';
          ctx.fillText(yn, x0 + pW / 2 - 15, y0 - 8);
          ctx.fillStyle = 'rgba(255,255,255,0.6)'; ctx.font = '10px sans-serif';
          ctx.fillText('予測 →', x0 + pW - 40, y0 + pH + 16);
          ctx.save(); ctx.translate(x0 - 30, y0 + pH / 2 + 20); ctx.rotate(-Math.PI / 2);
          ctx.fillText('実測', 0, 0); ctx.restore();
          // 目盛
          ctx.fillStyle = 'rgba(255,255,255,0.4)'; ctx.font = '9px monospace';
          for (let k = 0; k <= 4; k++) {
            const v = lo + (hi - lo) * k / 4;
            ctx.fillText(v.toFixed(1), x0 - 30, y0 + pH - pH * k / 4 + 3);
            ctx.fillText(v.toFixed(1), x0 + pW * k / 4 - 10, y0 + pH + 30);
          }
        });
        ctx.fillStyle = '#c8a96e'; ctx.font = 'bold 14px sans-serif';
        ctx.fillText('予実差散布図 (予測 vs 実測, 緑=2σ内, 橙=外れ, 点線=y=x)', 12, 18);
        audit('diff_plot_drawn', { rows: d.rows.length });
      } catch (e) {
        alert('予実差計算失敗: ' + e);
        console.error(e);
      } finally {
        btn.disabled = false; btn.textContent = '📊 予実差プロット描画';
      }
    });

    // STEP 4 完了時に STEP 11 もアンロック
    const _origSetStep = setStep;
    setStep = function(n, on) {
      _origSetStep(n, on);
      if (n === 7 && on) {
        const s11 = $('step11'); if (s11) { s11.style.opacity = '1'; s11.style.pointerEvents = 'auto'; }
      }
    };

    // 初期表示
    updateDataStatus();
  </script>
</BaseLayout>
