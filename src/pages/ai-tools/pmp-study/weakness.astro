---
import '../../../styles/pmp-mobile.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import WeaknessAnalyzer from '../../../components/pmp/WeaknessAnalyzer.tsx';
import TrademarkFooter from '../../../components/pmp/TrademarkFooter.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title="弱点分析 (概念単位) - PMP学習アプリ"
  description="解答履歴を知識グラフと結合し、新ECOタスク/章/タグ単位で弱点を診断。Governance・Compliance・Stakeholder expectation など概念レベルで原因を特定。"
>
  <div style="background:#0a0a0c;border-bottom:1px solid rgba(255,255,255,0.07);padding:0.7rem 1rem;">
    <div style="max-width:900px;margin:0 auto;display:flex;align-items:center;gap:1rem;">
      <a href={`${base}/ai-tools/pmp-study/`} style="color:rgba(237,237,232,0.6);font-size:0.75rem;text-decoration:none;letter-spacing:0.05em;">← ダッシュボード</a>
      <h1 style="color:#edede8;font-size:0.95rem;font-weight:300;letter-spacing:0.15em;margin:0;">🔍 弱点分析</h1>
    </div>
  </div>
  <WeaknessAnalyzer base={base} client:only="react" />
  <TrademarkFooter />
</BaseLayout>
