---
import '../../../../../styles/pmp-mobile.css';
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import lessonsData from '../../../../../data/pmp/lessons-official.json';
import lessonContent from '../../../../../data/pmp/lesson-content.json';
import TrademarkFooter from '../../../../../components/pmp/TrademarkFooter.astro';

export function getStaticPaths() {
  return (lessonsData as Array<{id: string}>).map((L) => ({ params: { id: L.id } }));
}

const { id: lessonId } = Astro.params;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lessons = lessonsData as Array<{ id: string; no: number; title_ja: string; title_en: string; objectives: string; outline: string; source: string; blueprint_submodules: Array<{code: string; title: string}> }>;
const lesson = lessons.find(L => L.id === lessonId)!;
const content = (lessonContent as Record<string, string>)[lessonId] || '';
const idx = lessons.findIndex(L => L.id === lessonId);
const prev = idx > 0 ? lessons[idx - 1] : null;
const next = idx < lessons.length - 1 ? lessons[idx + 1] : null;
const title = `L${String(lesson.no).padStart(2,'0')}: ${lesson.title_ja} - PMP学習`;

// Markdown → HTML 簡易 (見出しと箇条書きのみ)
function mdToHtml(md: string): string {
  const esc = (s: string) => s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const lines = md.split('\n');
  const out: string[] = [];
  let inList = false;
  for (const line of lines) {
    let m;
    if ((m = line.match(/^# (.+)/))) {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(`<h1 style="color:#c8a96e;font-size:1.5rem;font-weight:400;letter-spacing:0.05em;margin:2rem 0 1rem;">${esc(m[1])}</h1>`);
    } else if ((m = line.match(/^## (.+)/))) {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(`<h2 style="color:#edede8;font-size:1.15rem;font-weight:500;margin:1.6rem 0 0.7rem;border-left:3px solid #c8a96e;padding-left:0.7rem;">${esc(m[1])}</h2>`);
    } else if ((m = line.match(/^### (.+)/))) {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push(`<h3 style="color:rgba(237,237,232,0.9);font-size:0.95rem;font-weight:500;margin:1.2rem 0 0.5rem;">${esc(m[1])}</h3>`);
    } else if ((m = line.match(/^- \*\*(.+?)\*\* (.+)/))) {
      if (!inList) { out.push('<ul style="margin:0.5rem 0;padding-left:1.2rem;color:rgba(237,237,232,0.85);font-size:0.85rem;line-height:1.8;">'); inList = true; }
      out.push(`<li><strong style="color:#c8a96e;">${esc(m[1])}</strong> ${esc(m[2])}</li>`);
    } else if ((m = line.match(/^- (.+)/))) {
      if (!inList) { out.push('<ul style="margin:0.5rem 0;padding-left:1.2rem;color:rgba(237,237,232,0.85);font-size:0.85rem;line-height:1.8;">'); inList = true; }
      out.push(`<li>${esc(m[1])}</li>`);
    } else if (line.trim() === '---') {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push('<hr style="border:none;border-top:1px solid rgba(255,255,255,0.08);margin:1.5rem 0;">');
    } else if (line.trim() === '') {
      if (inList) { out.push('</ul>'); inList = false; }
      out.push('<div style="height:0.5rem;"></div>');
    } else {
      if (inList) { out.push('</ul>'); inList = false; }
      let processed = esc(line).replace(/\*\*(.+?)\*\*/g, '<strong style="color:#c8a96e;">$1</strong>');
      out.push(`<p style="color:rgba(237,237,232,0.85);font-size:0.85rem;line-height:1.8;margin:0.35rem 0;">${processed}</p>`);
    }
  }
  if (inList) out.push('</ul>');
  return out.join('\n');
}

const contentHtml = mdToHtml(content);
---

<BaseLayout title={title} description={lesson.outline.slice(0, 150)}>
  <div style="background:#0a0a0c;border-bottom:1px solid rgba(255,255,255,0.07);padding:0.7rem 1rem;">
    <div style="max-width:900px;margin:0 auto;display:flex;align-items:center;gap:1rem;flex-wrap:wrap;">
      <a href={`${base}/ai-tools/pmp-study/study`} style="color:rgba(237,237,232,0.6);font-size:0.75rem;text-decoration:none;letter-spacing:0.05em;">← レッスン一覧</a>
      <h1 style="color:#edede8;font-size:0.9rem;font-weight:300;letter-spacing:0.12em;margin:0;flex:1;">L{String(lesson.no).padStart(2,'0')} · {lesson.title_ja}</h1>
    </div>
  </div>

  <div style="max-width:900px;margin:0 auto;padding:1rem 1.2rem 4rem;">
    <article set:html={contentHtml} />

    <div style="margin-top:3rem;display:flex;gap:1rem;flex-wrap:wrap;">
      <a href={`${base}/ai-tools/pmp-study/quiz?lesson=${lessonId}`} style="background:#c8a96e;color:#0a0a0c;font-size:0.75rem;letter-spacing:0.15em;padding:0.7rem 1.4rem;text-decoration:none;font-weight:600;">📝 このレッスンで練習 →</a>
      <a href={`${base}/ai-tools/pmp-study/glossary`} style="background:transparent;color:#c8a96e;font-size:0.75rem;letter-spacing:0.15em;padding:0.7rem 1.4rem;text-decoration:none;border:1px solid rgba(200,169,110,0.4);">📖 用語集 (817語)</a>
    </div>

    <nav style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid rgba(255,255,255,0.06);display:flex;justify-content:space-between;gap:1rem;">
      {prev ? (
        <a href={`${base}/ai-tools/pmp-study/study/lesson/${prev.id}`} style="color:rgba(237,237,232,0.65);font-size:0.78rem;text-decoration:none;flex:1;">
          <span style="color:rgba(237,237,232,0.4);font-size:0.68rem;letter-spacing:0.1em;">← 前</span><br />
          L{String(prev.no).padStart(2,'0')} {prev.title_ja}
        </a>
      ) : <span style="flex:1;"></span>}
      {next ? (
        <a href={`${base}/ai-tools/pmp-study/study/lesson/${next.id}`} style="color:rgba(237,237,232,0.65);font-size:0.78rem;text-decoration:none;flex:1;text-align:right;">
          <span style="color:rgba(237,237,232,0.4);font-size:0.68rem;letter-spacing:0.1em;">次 →</span><br />
          L{String(next.no).padStart(2,'0')} {next.title_ja}
        </a>
      ) : <span style="flex:1;"></span>}
    </nav>
  </div>

  <TrademarkFooter />
</BaseLayout>
